{
    "validate_excel_load_data_timegranularity": [
        {
            "testStep": "Extract scenario version from listHistoricals API",
            "environment": "qa",
            "labels": [
                "smoke",
                "regression",
                "time-grain",
                "listHistoricals"
            ],
            "service": "coreService",
            "uri": "listHistoricals",
            "testName": "Get scenarios for excel",
            "queryParams": "dim_val_id=120010&dim_id=12&data_level=11&classification_id=12",
            "method": "GET",
            "assertions": [
                {
                    "status": 200
                }
            ],
            "extractFirst": {
                "time_grain_scenario_version_timestamp": "row_data.scenario_version_timestamp",
                "time_grain_scenario_id": "row_data.scenario_id",
                "time_grain_actual_template_id": "row_data.actual_template_id",
                "time_grain_forecast_template_id": "row_data.forecast_template_id"
            }
        },{
            "testStep": "Validate scenarios API - All time granularities",
            "testName": "Validate scenarios API - All time granularities",
            "environment": "qa",
            "labels": [
                "smoke",
                "regression",
                "time-grain",
                "IBGROW-38244"
            ],
            "service": "reportingService",
            "uri": "scenarios",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "node_var_names": [
                    "momerchandisesales"
                ],
                "scenarios": [
                    {
                        "scenario_id": "{{time_grain_scenario_id}}",
                        "scenario_ver": "{{time_grain_scenario_version_timestamp}}",
                        "actual_scenario_id": "{{time_grain_actual_template_id}}",
                        "forecast_scenario_id": "{{time_grain_forecast_template_id}}",
                        "type": "scenarios"
                    }
                ],
                "filters": {
                    "department": [
                        80,
                        83,
                        32
                    ]
                },
                "hierarchy_names": [
                    "MP_CHANNEL_LEVELS",
                    "SBU"
                ],
                "periods": [
                    "2026"
                ],
                "period_type": "year",
                "period_levels": [
                    "month",
                    "quarter",
                    "half_year"
                ],
                "dimensions": [],
                "pivot_rows": [
                "node_var_name"
                ],
                "pivot_columns": [
                "period",
                "scenario_id"
                ]
            },
            "extractFirst": {
                "year_value1": "row_data.FY26",
                "half_value1": "row_data.FY26 H2",
                "quarter_value1": "row_data.FY26 Q2",
                "month_value1": "row_data.Feb FY26"
            },
            "assertions": [
                {
                    "status": 200
                },
                {
                    "assertNotNull": [
                        "{{year_value1}}",
                        "{{half_value1}}",
                        "{{quarter_value1}}",
                        "{{month_value1}}"
                    ]
                }
            ]
        },
