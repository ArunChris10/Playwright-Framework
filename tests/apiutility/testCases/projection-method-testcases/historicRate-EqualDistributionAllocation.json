      "extractRelative": {
        "historic_EqualDistb_forecastDriverOne_KpiData": {
          "whereKey": "driver",
          "equals": "grossgmv",
          "extractKey": "{{dynamicMonth+1}}.forecast"
        },
        "historic_EqualDistb_forecastDriverTwo_KpiData": {
          "whereKey": "driver",
          "equals": "unitsgrossuomng_input",
          "extractKey": "{{dynamicMonth+1}}.forecast"
        },
        "historic_EqualDistb_forecastDriverThree_KpiData": {
          "whereKey": "driver",
