            },
            {
              "name": "Value",
              "editable": true
            }
          ],
          "month": [
            "{{dynamicMonth+1}}",
            "{{dynamicMonth+2}}"
          ]
        },
        "adjustment_id": "{{historic_EqualDistb_adjustmentId}}",
        "isApplied": false
      },
      "assertions": {
        "status": 200
