  "validate_saved_values_historic_EqualDistb_GetKpi": [
    {
            "runInParallel": false,
      "testStep": "Validate update for historic_EqualDistb SavedData",
      "environment": "qa",
      "labels": [
        "smoke",
        "MS1"
      ],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "Validate saved data for historic_EqualDistb - GetKpi",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "scenario_id": "{{Projection_Hist_EqualDistb_scenario_id}}",
        "scenario_version": "{{Projection_Hist_EqualDistb_scenario_version}}",
        "dim_id": 11,
        "dim_val_id": 110030,
        "classification_id": 12,
        "template_id": 3,
        "filters": [],
        "additional_filters": {
          "pivot_cols": [
            "month"
          ],
          "pivot_index": [
            "node_id"
          ],
          "period_view": [
            "month"
          ],
          "nodes": [
            "grossgmv",
            "unitsgrossuomng_input",
            "financialservicesincome"
          ],
          "template_include_headers": [
            {
              "name": "Driver"
            },
            {
              "name": "{{dynamicMonth+1}}",
