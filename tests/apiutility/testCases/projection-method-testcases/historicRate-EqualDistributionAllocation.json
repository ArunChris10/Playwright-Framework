          "extractKey": "{{dynamicMonth+2}}.forecast"
        }
      },
      "validateExtractToBeApprox": {
        "historic_EqualDistb_forecastDriverOne_KpiData": {
          "expected": "{{historic_EqualDistb_forecastDriverOne}}",
          "tolerance": 50
        },
        "historic_EqualDistb_forecastDriverTwo_KpiData": {
          "expected": "{{historic_EqualDistb_forecastDriverTwo}}",
          "tolerance": 50
        },
        "historic_EqualDistb_forecastDriverThree_KpiData": {
          "expected": "{{historic_EqualDistb_forecastDriverThree}}",
          "tolerance": 50
        }
