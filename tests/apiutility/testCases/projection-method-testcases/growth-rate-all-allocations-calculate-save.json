{
  "Create Scenario for growthRate projection_with Constant Value": [
    {
      "runInParallel": false,
      "testStep": "Projection_growthRate with constant_Get a forecast to delete before proceding for Demand SBA",
      "environment": "qa",
      "labels": [
        "smoke",
        "MS3"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Projection_growthRate_Constant_Get a forecast to delete before proceding for Demand SBA",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120011,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelativeMultipleCondition": {
        "Projection_growthRate_ConstantScenariotoDeletescenarioId": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110030
            },
            {
              "path": "rowData.owner",
              "equals": "LB-ibg-ufm-auto"
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioId"
        },
        "Projection_growthRate_ConstantScenariotoDeletescenarioVersion": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110030
            },
            {
              "path": "rowData.owner",
              "equals": "LB-ibg-ufm-auto"
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioVersion"
        }
      }
    },
    {
      "testStep": "Projection_growthRate_Constant_Delete Demand SBA forecast before proceding",
      "environment": "qa",
      "labels": [
        "smoke"
      ],
      "service": "coreService",
      "uri": "Forecast",
      "testName": "Projection_growthRate_Constant_Delete a IO forecast before proceding",
      "queryParams": "/{{Projection_growthRate_ConstantScenariotoDeletescenarioId}}/{{Projection_growthRate_ConstantScenariotoDeletescenarioVersion}}",
      "method": "DELETE",
      "payload": {
        "dim_id": 11,
        "dim_val_id": 110030
      }
    },
    {
      "testStep": "Projection_growthRate_Constant_Create Forecast Scenario for Demand SBA",
      "environment": "qa",
      "labels": [
        "smoke",
        "Pre-Req"
      ],
      "service": "coreService",
      "uri": "Forecast",
      "testName": "Projection_growthRate_Constant_Validate create forecast- Demand SBA",
      "queryParams": "/create-user-scenario",
      "method": "POST",
      "payload": {
        "type": 3,
        "name": "Constant_Value_Growth_Rate_{{randomNumber}}",
        "classification_id": 12,
        "dim_id": 11,
        "dim_val_id": 110030
      },
      "extract": {
        "Projection_growthRate_scenario_id": "scenario.scenario_id",
        "Projection_growthRate_scenario_version": "scenario.scenario_version_timestamp"
      },
      "assertions": [
        {
          "status": 200
        }
      ]
    },
    {
      "testStep": "Projection_growthRate_Constant_Poll creation of Demand FORECAST",
