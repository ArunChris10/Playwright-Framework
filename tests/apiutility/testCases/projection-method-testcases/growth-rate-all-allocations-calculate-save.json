      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "growthRate_ConstantValue_forecastDriverOne": {
          "whereKey": "node_var_name",
          "equals": "grossgmv",
          "extractKey": "edits.{{dynamicMonth+1}}.forecast"
