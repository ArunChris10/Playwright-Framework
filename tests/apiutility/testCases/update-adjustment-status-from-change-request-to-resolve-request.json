  ,
  {
    "testStep": "update the status to change request through BA screen",
    "environment": "qa",
    "labels": [
      "smoke","MS2","IBG-39617","IBG-39616"
    ],
    "service": "coreService",
    "uri": "sendToBAReview",
    "testName": "update the status to change request through BA screen",
    "queryParams": "",
    "method": "POST",
    "payload": {
        "adjustments":{
        "adjustment_id":"{{level1_save_adjustmentId}}",
        "status":25,"comments":"Update status to changes requested"}
    },
    "assertions": [
      {
        "status": 200
      },
      {
        "assertEquals": {
          "jsonPath1": "adjustment_status.initial_status",
          "value1": 21,
          "jsonPath2": "adjustment_status.end_status",
          "value2": 25,
          "jsonPath3": "adjustment_status.comments",
          "value3": "Update status to changes requested"
        }
      }
    ]
  }  ,
