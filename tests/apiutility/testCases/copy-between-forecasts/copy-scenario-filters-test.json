{
    "verify copy scenario action with filters": [
      {
        "testStep": "create source scenario",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters",
        "Visualization",
        "CopyScenario",
      "@ibg-ufm-core-service" , "@ibg-ufm-domino-service" , "@ibg-ufm-allocation-engine" ,"@@ibg-ufm-reporting-proxy"],
        "service": "coreService",
        "uri": "createUserScenario",
        "testName": "Create a new Scenario",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "dim_id": 11,
          "dim_val_id": 110030,
          "classification_id": 12,
          "type":3,
          "name": "Test-Filter-Source-{{randomNumber}}"
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractFirst": {
            "sourceScenarioId": "scenario.scenario_id",
            "sourceScenarioVersion": "scenario.scenario_version_timestamp"
        }

      },

      {
        "testStep": "create target scenario",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters"],
        "service": "coreService",
        "uri": "createUserScenario",
        "testName": "Create a new Scenario",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "dim_id": 11,
          "dim_val_id": 110030,
          "classification_id": 12,
          "type":3,
          "name": "Test-Filter-Target-{{randomNumber}}"
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractFirst": {
            "target1ScenarioId": "scenario.scenario_id",
            "target1ScenarioVersion": "scenario.scenario_version_timestamp"
        }

      },
      {
        "testStep": "Poll creation of Source FORECAST",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters"],
        "service": "coreService",
        "uri": "getForecast",
        "testName": "Poll creation of Source FORECAST",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "unit": "Millions",
          "dim_id": 12,
          "dim_val_id": 120011,
          "classification_id": 12,
          "template_id": 1,
          "filters": [],
          "additional_filters": {
            "template_include_headers": [
              {
                "name": "vs LY",
                "format": "percent"
              },
              {
                "name": "vs Plan",
                "format": "absolute"
              }
            ]
          }
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractRelative": {
            "sourceATS": {
              "whereKey": "rowData.name",
              "equals": "Test-Filter-Source-{{randomNumber}}",
              "extractKey": "rowData.ATS"
            },
            "sourceFTS": {
              "whereKey": "rowData.name",
              "equals": "Test-Filter-Source-{{randomNumber}}",
              "extractKey": "rowData.FTS"
          }
          },

        "polling": {
          "extractRelative": {
            "WhereKey": "rowData.name",
            "Equals": "Test-Filter-Source-{{randomNumber}}",
            "Findkey": "rowData.forecastStatus.statusCode"
          },
          "expectedValue": 21,
          "intervalMs": 5000,
          "timeoutMs": 600000
        }
      },
      {
        "testStep": "Poll creation of Target",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters"],
        "service": "coreService",
        "uri": "getForecast",
        "testName": "Poll creation of Target FORECAST",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "unit": "Millions",
          "dim_id": 12,
          "dim_val_id": 120011,
          "classification_id": 12,
          "template_id": 1,
          "filters": [],
          "additional_filters": {
            "template_include_headers": [
              {
                "name": "vs LY",
                "format": "percent"
              },
              {
                "name": "vs Plan",
                "format": "absolute"
              }
            ]
          }
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractRelative": {
          "target1ATS": {
            "whereKey": "rowData.name",
            "equals": "Test-Filter-Target-{{randomNumber}}",
            "extractKey": "rowData.ATS"
          },
          "target1FTS": {
            "whereKey": "rowData.name",
            "equals": "Test-Filter-Target-{{randomNumber}}",
            "extractKey": "rowData.FTS"
        }
        },

        "polling": {
          "extractRelative": {
            "WhereKey": "rowData.name",
            "Equals": "Test-Filter-Target-{{randomNumber}}",
            "Findkey": "rowData.forecastStatus.statusCode"
          },
          "expectedValue": 21,
          "intervalMs": 5000,
          "timeoutMs": 600000
        }
      },
      {
        "testStep": "Perform Adjustment on Source Senario",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters"],
        "service": "coreService",
        "uri": "saveAdjustment",
        "testName": "Make adjustment on Source Scenario",
        "queryParams": "",
        "method": "PATCH",
        "payload": {
          "adjustment_metadata": {
            "adjustment_name": "Test Adjustment Copy Filter - {{randomNumber}}",
            "adjustment_reason": "Test Adjustment Copy Filter - {{randomNumber}}",
            "adjustment_type": 74,
            "is_duplicated": false,
            "is_update": false,
            "is_create": true,
            "adjustment_edits": 1,
            "scenario_id": "{{sourceScenarioId}}",
            "scenario_version_timestamp": "{{sourceScenarioVersion}}"
          },
          "allocation_request": {
            "display_nodes": [],
            "scenario_id": "{{sourceScenarioId}}",
            "dim_val_id": 110030,
            "dim_id": 11,
            "preview": false,
            "edits": [
              {
                "node_var_name": "tempplugforuom",
                "node_dimension": {},
                "data": {
                  "{{dynamicMonth+1}}": 100000
                },
                "allocation": {
                  "interval": null,
                  "offset": null,
                  "method": 29
                }
              }
            ],
            "filters": [{"dim_id":1,"dim_val_ids":[1],"children":[]}],
            "period_view": "month"
          },
          "dim_val_id": 110030
        },
        "assertions": [
          {
            "status": 200
          }
        ]
      },
      {
        "testStep": "Initianlize Copy Scenario",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters"],
        "service": "utilityService",
        "uri": "copyScenario",
        "testName": "copy source scenario data to targets",
        "queryParams": "",
        "method": "POST",
        "payload": {
            "dim_val_id": 110030,
            "dim_id": 11,
            "source_scenario": {
                "scenario_id-tostring": "{{sourceScenarioId}}",
                "scenario_version-tostring": "{{sourceScenarioVersion}}",
                "type": "scenarios",
                "actual_scenario_id-tostring": "{{sourceATS}}",
                "forecast_scenario_id-tostring": "{{sourceFTS}}"
            },
            "target_scenario": [
                {
                    "scenario_id": "{{target1ScenarioId}}",
                    "scenario_version": "{{target1ScenarioVersion}}",
                    "type": "scenarios",
                    "actual_scenario_id":"{{target1ATS}}",
                    "forecast_scenario_id": "{{target1FTS}}"
                }
            ],
            "additional_filters": {
                "period_view": [
                    "month"
                ],
                "nodes": [
                    "tempplugforuom"
                ],
                "month": [
                    "{{dynamicMonth+1}}"
                ]
            },
            "filters": [{"dim_id":1,"dim_val_ids":[1],"children":[]}]
        },
        "assertions": [
          {
            "status": 200
          }
        ]
      },
          {
      "testStep": "Poll the copy scenario process until its completed",
      "environment": "qa",
      "labels": [
        "smoke",
        "copy_scenario_draft_source_select_drivers"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Poll the copy scenario process until its completed",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120011,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "polling": {
        "extractRelative": {
          "WhereKey": "rowData.name",
          "Equals": "Test-Filter-Target-{{randomNumber}}",
          "Findkey": "rowData.forecastStatus.statusCode"
        },
        "expectedValue": 21,
        "intervalMs": 5000,
        "timeoutMs": 600000
      }
    },
      {
        "testStep": "Poll Until Adjustment For Target 1 Applied For Validation",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_filters"],
        "service": "coreService",
        "uri": "getKpiV2",
        "testName": "Get Target data",
        "queryParams": "",
        "method": "POST",
        "payload": {
            "baseURL": "",
            "scenario_id": "{{target1ScenarioId}}",
            "scenario_version": "{{target1ScenarioVersion}}",
            "dim_id": 11,
            "dim_val_id": 110030,
            "classification_id": 12,
            "template_id": 3,
            "filters": [{"dim_id":1,"dim_val_ids":[1],"children":[]}],
            "additional_filters": {
                "pivot_cols": [
                    "month"
                ],
                "pivot_index": [
                    "node_id"
                ],
                "period_view": [
                    "month"
                ],
                "nodes": [
                    "tempplugforuom"
                ],
                "template_include_headers": [
                    {
                        "name": "Driver"
                    },
                    {
                        "name": "{{dynamicMonth+1}}",
                        "columnsMenuParams": "middleColumns"
                    },
                    {
                        "name": "",
                        "columnsMenuParams": "fixedColumns"
                    },
                    {
                        "name": "Allocation Method",
                        "columnsMenuParams": "action"
                    },
                    {
                        "name": "Forecast",
                        "editable": true
                    },
                    {
                        "name": "Value",
                        "editable": true
                    }
                ],
                "month": [
                    "{{dynamicMonth+1}}"
                ]
            },
            "isApplied": true
        },
        "extractRelative": {
        "driver_value": {
          "whereKey": "rowData.driver",
          "equals": "tempplugforuom",
          "extractKey": "rowData.{{dynamicMonth+1}}.forecast"
        }
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertValuesAreEqual": [
            "{{driver_value}}",
            100000
          ]
        }
      ]
      },
