      {
        "testStep": "Initianlize Copy Scenario",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_multiple_targets"],
        "service": "utilityService",
        "uri": "copyScenario",
        "testName": "copy source scenario data to targets",
        "queryParams": "",
        "method": "POST",
        "payload": {
            "dim_val_id": 110030,
            "dim_id": 11,
            "source_scenario": {
                "scenario_id-tostring": "{{sourceScenarioId}}",
                "scenario_version-tostring": "{{sourceScenarioVersion}}",
                "type": "scenarios",
                "actual_scenario_id-tostring": "{{sourceATS}}",
                "forecast_scenario_id-tostring": "{{sourceFTS}}"
            },
            "target_scenario": [
                {
                    "scenario_id": "{{target1ScenarioId}}",
                    "scenario_version": "{{target1ScenarioVersion}}",
                    "type": "scenarios",
                    "actual_scenario_id":"{{target1ATS}}",
                    "forecast_scenario_id": "{{target1FTS}}"
                },
                {
                    "scenario_id": "{{target2ScenarioId}}",
                    "scenario_version": "{{target2ScenarioVersion}}",
                    "type": "scenarios",
                    "actual_scenario_id":"{{target2ATS}}",
                    "forecast_scenario_id": "{{target2FTS}}"
                }
            ],
            "additional_filters": {
                "period_view": [
                    "month"
                ],
                "nodes": [
                    "tempplugforuom"
                ],
                "month": [
                    "{{dynamicMonth+1}}"
                ]
            },
            "filters": []
        },
        "assertions": [
          {
            "status": 200
          }
        ]
      },
      {
        "testStep": "Get Source Data For Validation",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_multiple_targets"],
        "service": "coreService",
        "uri": "getKpiV2",
        "testName": "Get Source data",
        "queryParams": "",
        "method": "POST",
        "payload": {
            "scenario_id": "{{sourceScenarioId}}",
            "scenario_version": "{{sourceScenarioVersion}}",
            "dim_id": 11,
            "dim_val_id": 110030,
            "classification_id": 12,
            "template_id": 3,
            "filters": [],
            "additional_filters": {
                "pivot_cols": [
                    "month"
                ],
                "pivot_index": [
                    "node_id"
                ],
                "period_view": [
                    "month"
                ],
                "nodes": [
                    "tempplugforuom"
                ],
                "template_include_headers": [
                    {
                        "name": "Driver"
                    },
                    {
                        "name": "{{dynamicMonth+1}}",
                        "columnsMenuParams": "middleColumns"
                    },
                    {
                        "name": "",
                        "columnsMenuParams": "fixedColumns"
                    },
                    {
                        "name": "Allocation Method",
                        "columnsMenuParams": "action"
                    },
                    {
                        "name": "Forecast",
                        "editable": false
                    },
                    {
                        "name": "Value",
                        "editable": false
                    }
                ],
                "month": [
                    "{{dynamicMonth+1}}"
                ]
            },
            "isApplied": true
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractFirst" : {
          "sourceData": "rowData[0].{{dynamicMonth+1}}.forecast"
        }
