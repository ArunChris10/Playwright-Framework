{
    "verify copy scenario action for historical source": [
      {
        "testStep": "fetch historical forecast as source scenario",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_multiple_targets",
        "Visualization",
        "CopyScenario",
      "ibg-ufm-core-service" , "ibg-ufm-domino-service" , "ibg-ufm-allocation-engine" ,"ibg-ufm-reporting-proxy"],
        "service": "coreService",
        "uri": "Forecast",
        "testName": "Create a new Scenario",
        "queryParams": "/list-historicals?dim_val_id=110030&dim_id=12&data_level=11&classification_id=12",
        "method": "GET",
        "payload": {
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractFirst": {
            "sourceScenarioId": "row_data[0].scenario_id",
            "sourceScenarioVersion": "row_data[0].scenario_version_timestamp",
            "sourceATS": "row_data[0].actual_template_id",
            "sourceFTS": "row_data[0].forecast_template_id"
        }

      },
      {
        "testStep": "create target scenario 1",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_multiple_targets"],
        "service": "coreService",
        "uri": "createUserScenario",
        "testName": "Create a new Scenario",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "dim_id": 11,
          "dim_val_id": 110030,
          "classification_id": 12,
          "type":3,
          "name": "Test-TG-01-{{randomNumber}}"
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractFirst": {
            "target1ScenarioId": "scenario.scenario_id",
            "target1ScenarioVersion": "scenario.scenario_version_timestamp"
        }

      },
      {
        "testStep": "create target scenario 2",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_multiple_targets"],
        "service": "coreService",
        "uri": "createUserScenario",
        "testName": "Create a new Scenario",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "dim_id": 11,
          "dim_val_id": 110030,
          "classification_id": 12,
          "type":3,
          "name": "Test-TG-02-{{randomNumber}}"
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractFirst": {
            "target2ScenarioId": "scenario.scenario_id",
            "target2ScenarioVersion": "scenario.scenario_version_timestamp"
        }

      },
      {
        "testStep": "Poll creation of Target 1 FORECAST",
        "environment": "qa",
        "labels": ["smoke", "copy_scenario_multiple_targets"],
        "service": "coreService",
        "uri": "getForecast",
        "testName": "Poll creation of Source FORECAST",
        "queryParams": "",
        "method": "POST",
        "payload": {
          "unit": "Millions",
          "dim_id": 12,
          "dim_val_id": 120011,
          "classification_id": 12,
          "template_id": 1,
          "filters": [],
          "additional_filters": {
            "template_include_headers": [
              {
                "name": "vs LY",
                "format": "percent"
              },
              {
                "name": "vs Plan",
                "format": "absolute"
              }
            ]
          }
        },
        "assertions": [
          {
            "status": 200
          }
        ],
        "extractRelative": {
          "target1ATS": {
            "whereKey": "rowData.name",
            "equals": "Test-TG-01-{{randomNumber}}",
            "extractKey": "rowData.ATS"
          },
          "target1FTS": {
            "whereKey": "rowData.name",
            "equals": "Test-TG-01-{{randomNumber}}",
            "extractKey": "rowData.FTS"
        }
        },

        "polling": {
          "extractRelative": {
            "WhereKey": "rowData.name",
            "Equals": "Test-TG-01-{{randomNumber}}",
            "Findkey": "rowData.forecastStatus.statusCode"
          },
          "expectedValue": 21,
          "intervalMs": 5000,
          "timeoutMs": 600000
        }
      },
