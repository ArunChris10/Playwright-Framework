{
    "verify calculate and save for additive patchy and non additive nodes in a SBA": [
        {
            "testStep": "Get a forecast to calculate for additive and non-additive patchy nodes",
            "environment": "qa",
            "labels": [
                "smoke",
                "additive_patchy_allocation"
            ],
            "service": "coreService",
            "uri": "getForecast",
            "testName": "Get a forecast to calculate at lower grain",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "unit": "Millions",
                "dim_id": 12,
                "dim_val_id": 120011,
                "classification_id": 12,
                "template_id": 1,
                "filters": [],
                "additional_filters": {
                    "template_include_headers": [
                        {
                            "name": "vs LY",
                            "format": "percent"
                        },
                        {
                            "name": "vs Plan",
                            "format": "absolute"
                        }
                    ]
                }
            },
            "assertions": [
                {
                    "status": 200
                }
            ],
            "extractRelativeMultipleCondition": {
                "scenario_id": {
                    "conditions": [
                        {
                            "path": "rowData.lineOfBusiness",
                            "equals": 110030
                        },
                        {
                            "path": "rowData.forecastStatus.statusCode",
                            "equals": 21
                        }
                    ],
                    "extractKey": "scenarioId"
                },
                "scenarioVersion": {
                    "conditions": [
                        {
                            "path": "rowData.lineOfBusiness",
                            "equals": 110030
                        },
                        {
                            "path": "rowData.forecastStatus.statusCode",
                            "equals": 21
                        }
                    ],
                    "extractKey": "scenarioVersion"
                }
            }
        },
        {
            "testStep": "Editing and Calculating the additive and non additive nodes",
            "environment": "qa",
            "labels": [
                "smoke",
                "additive_patchy_allocation"
            ],
            "service": "coreService",
            "uri": "allocateData",
            "testName": "Calculating the additive and non additive nodes",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "display_nodes": [],
                "scenario_id": "{{scenario_id}}",
                "dim_id": 11,
                "dim_val_id": 110030,
                "preview": true,
                "edits": [
                    {
                        "node_var_name": "instorereturnspctofgrossgmv",
                        "node_dimension": {},
                        "data": {
                            "202611": 0.060221936902098844
                        },
                        "allocation": {
                            "interval": null,
                            "offset": null,
                            "method": 29
                        }
                    },
                    {
                        "node_var_name": "storereturns_input",
                        "node_dimension": {},
                        "data": {
                            "202610": 12
                        },
                        "allocation": {
                            "interval": null,
                            "offset": null,
                            "method": 29
                        }
                    }
                ],
                "filters": [],
                "period_view": "month",
                "adjustment_id": 1750975330729
            },
            "assertions": [
                {
                    "status": 200
                },
                {
                    "assertNotNull": {
                        "jsonPath1": "node_var_name"
                    }
                }
            ]
        },
        {
            "testStep": "Saving the adjustment after calculating the additive and non additive nodes",
            "environment": "qa",
            "labels": [
                "smoke",
                "additive_non_additive_calculate_equal_distribution"
            ],
            "service": "coreService",
            "uri": "saveAdjustment",
            "testName": "Save the calculation for all the additive and non additive nodes in the SBA",
            "queryParams": "",
            "method": "PATCH",
            "payload": {
                "adjustment_metadata": {
                    "adjustment_name": "demo_test_additive_non_additive {{randomNumber}}",
                    "adjustment_reason": "",
                    "adjustment_type": 74,
                    "is_duplicated": false,
                    "is_update": false,
                    "is_create": true,
                    "adjustment_edits": 16,
                    "scenario_id": "{{scenario_id}}",
                    "scenario_version_timestamp": "{{scenarioVersion}}"
                },
                "allocation_request": {
                    "display_nodes": [],
                    "scenario_id": "{{scenario_id}}",
                    "dim_val_id": 110030,
                    "dim_id": 11,
                    "preview": false,
                    "edits": [
                        {
                            "node_var_name": "instorereturnspctofgrossgmv",
                            "node_dimension": {},
                            "data": {
                                "202611": 0.060221936902098844
                            },
                            "allocation": {
                                "interval": null,
                                "offset": null,
                                "method": 29
                            }
                        },
                        {
                            "node_var_name": "storereturns_input",
                            "node_dimension": {},
                            "data": {
                                "202610": 12
                            },
                            "allocation": {
                                "interval": null,
                                "offset": null,
                                "method": 29
                            }
                        }
                    ],
                    "filters": [],
                    "period_view": "month"
                },
                "dim_val_id": 110030
            },
            "assertions": [
                {
                    "status": 200
                },
                {
                    "assertEquals": {
                        "jsonPath1": "message",
                        "value1": "New adjustment created successfully!!"
                    }
                }
            ],
            "extract": {
                "adjustmentId": "adjustment_metadata.adjustment_id"
            }
        }, {
            "testStep": "Delete Adjustment",
            "environment": "qa",
            "labels": [
              "smoke",
              "non_additive_patchy_allocation"
            ],
            "service": "coreService",
            "uri": "saveAdjustment",
            "testName": "Delete Adjustment",
            "queryParams": "{{adjustmentId}}?scenario_id={{scenario_id}}&scenario_version_timestamp={{scenarioVersion}}",
            "method": "DELETE",
            "payload": {},
            "assertions": [
              {
                "status": 200
              }
            ]
        }
    ]
}