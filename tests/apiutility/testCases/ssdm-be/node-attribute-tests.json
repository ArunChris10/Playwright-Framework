{
  "Create_Get_Update_Delete_Node_Attribute": [
    {
      "testStep": "Get Nodes",
      "environment": "qa",
      "labels": [
        "smoke",
        "Node Attribute",
        "Regression",
        "ibg-ufm-domino-service",
        "ibg-ufm-metadata-service",
        "ibg-ufm-core-service"
      ],
      "service": "ssdmService",
      "uri": "getAllNodes",
      "testName": "Create_Get_Update_Delete_Node_Attribute",
      "queryParams": "",
      "method": "GET",
      "extractFirst": {
        "node_key": "node_key"
      }
    },
    {
      "testStep": "Get Attributes",
      "environment": "qa",
      "labels": [
        "smoke",
        "Node Attribute",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "getAllAttributes",
      "testName": "Create_Get_Update_Delete_Node_Attribute",
      "queryParams": "",
      "method": "GET",
      "extractFirst": {
        "attribute_key": "attribute_key"
      }
    },
    {
      "testStep": "Create a Node Attribute for a valid Key",
      "environment": "qa",
      "labels": [
        "smoke",
        "Node Attribute",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "getAllNodes",
      "testName": "Create_Get_Update_Delete_Node_Attribute",
      "queryParams": "/{{node_key}}/attributes",
      "method": "POST",
      "payload": {
        "attribute_val": "Test Attribute Value",
        "attribute_key": "{{attribute_key}}"
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "attribute_val",
            "value": "Test Attribute Value"
          }
        }
      ]
    },
    {
      "testStep": "Create a Node Attribute for an valid Node Key",
      "environment": "qa",
      "labels": [
        "smoke",
        "Node Attribute",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "getAllNodes",
      "testName": "Create_Get_Update_Delete_Node_Attribute",
      "queryParams": "/20000/attributes",
      "method": "POST",
      "payload": {
        "attribute_val": "Test Attribute Value",
        "attribute_key": "{{attribute_key}}"
      },
      "assertions": [
        {
          "status": 409
        },
        {
          "assertEquals": {
            "jsonPath1": "detail",
            "value": "Invalid NODE_KEY 20000"
          }
        }
      ]
    },
    {
      "testStep": "Create a Node Attribute for an valid Node Key but Invalid Attribute ID",
