{
  "Publish_Republish_Driver_Tree_Versions": [
    {
      "testStep": "Get Driver Trees",
      "environment": "qa",
      "labels": [
        "smoke",
        "Driver_Tree_Publish_Republish",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "getAllDriverTrees",
      "testName": "Publish_Republish_Driver_Tree_Versions",
      "queryParams": "",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "driver_tree_key": "driver_tree_key"
      }
    },
    {
      "testStep": "Get Driver Tree Versions",
      "environment": "qa",
      "labels": [
        "smoke",
        "Driver_Tree_Publish_Republish",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "getAllDriverTrees",
      "testName": "Publish_Republish_Driver_Tree_Versions",
      "queryParams": "/{{driver_tree_key}}/versions",
      "method": "GET",
       "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelativeMultipleCondition": {
        "driver_tree_version_draft": {
          "conditions": [
            {
              "path": "is_published",
              "equals": false
            },
            {
              "path": "is_active",
              "equals": true
            }
          ],
          "extractKey": "driver_tree_version"
        }
      },
   "extractFromGlobalStoreSubKey": {
    "fetched_driver_tree_version_draft": {
      "sourceGlobalKey": "driver_tree_version_draft",
      "subKey": "driver_tree_version"
    }
  }

    },
