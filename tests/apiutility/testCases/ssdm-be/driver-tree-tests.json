{
  "Get_all_Driver_Trees_in_the_system": [
    {
      "testStep": "Fetch All Driver Trees",
      "environment": "qa",
      "labels": [
        "smoke",
        "Driver_Trees","Regression",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "getAllDriverTrees",
      "testName": "Get all driver trees",
      "queryParams": "",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        },
        {
          "assertNotNull": {
            "jsonPath": "driver_tree_key"
          }
        },
        {
          "assertNotNull": {
            "jsonPath1": "driver_tree_name"
          }
        },
        {
          "assertNotNull": {
            "jsonPath2": "driver_tree_description"
          }
        }
      ]
    }
  ],
  "Create_Get_Update_Delete_a_Driver_Tree_in_the_system": [
    {
      "testStep": "Create A Driver Tree",
      "environment": "qa",
      "labels": [
        "smoke",
        "Driver_Trees","Regression",
        "Regression"
      ],
      "service": "ssdmService",
      "uri": "createDriverTree",
      "testName": "Create a driver trees",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "driver_tree_name": "create_driver_tree_name",
        "driver_tree_description": "create_driver_tree_description"
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertNotNull": {
            "jsonPath": "driver_tree_key"
          }
        },
        {
          "assertEquals": {
            "jsonPath1": "driver_tree_name",
            "value": "create_driver_tree_name"
          }
        },
        {
          "assertEquals": {
            "jsonPath2": "driver_tree_description",
            "value": "create_driver_tree_description"
          }
        }
      ],
      "extractFirst": {
        "created_driver_key": "driver_tree_key"
      }
    },
    {
      "testStep": "Get A Specific Driver Tree for a valid Key",
      "environment": "qa",
      "labels": ["smoke", "Driver_Trees","Regression"],
      "service": "ssdmService",
      "uri": "getAllDriverTrees",
      "testName": "Get a driver trees",
      "queryParams": "{{created_driver_key}}",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        },
        {"assertEquals": {
        "jsonPath": "driver_tree_key",
        "value": "{{created_driver_key}}"
      }
    },
    {
      "assertEquals": {
        "jsonPath10": "driver_tree_name",
        "value": "create_driver_tree_name"
      }
    },
  {
    "assertEquals": {
        "jsonPath11": "driver_tree_description",
        "value": "create_driver_tree_description"
      }
    }

