{
  "validate_download_api_positive": [
    {
      "testStep": "Call download API with valid document ID",
      "environment": "qa",
      "labels": [
        "@Smoke",
        "downloadApi",
        "@Regression"
      ],
      "service": "coreService",
      "uri": "download",
      "testName": "validate successful file download from download API",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "doc_id": "10611748438977"
      },
      "assertion": [
        {
          "status": 200
        },
        {
          "assertHeader": {
            "header": "Content-Disposition",
            "contains": "attachment"
          }
        },
        {
          "assertBinarySignature": {
            "startsWith": "504b0304"
          }
        }
      ]
    }
  ],
