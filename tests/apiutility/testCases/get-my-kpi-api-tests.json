{
  "get_and_compare_kpi_forecast_with_and_without_filters": [
    {
      "testStep": "Get forecast for KPI filters",
      "environment": "qa",
      "labels": ["smoke", "IBGROW-36348","MS3"],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get forecast for KPI filters",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120006,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "getkpi3_scenario_id": "rowData.scenarioId",
        "getkpi3_scenario_version": "rowData.scenarioVersion"
      }
    },
    {
      "testStep": "Call getMyKPI API without filters",
      "environment": "qa",
      "labels": ["smoke","IBGROW-36348","MS3"],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "validate getMyKPI API before filter",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "scenario_id": "{{getkpi3_scenario_id}}",
        "scenario_version": "{{getkpi3_scenario_version}}",
        "dim_id": 11,
        "dim_val_id": 110009,
        "classification_id": 12,
        "template_id": 3,
        "filters": [],
        "additional_filters": {
          "pivot_cols": ["month"],
          "pivot_index": ["node_id"],
          "period_view": ["month"],
          "nodes": ["membershipincome_input"],
          "template_include_headers": [
            { "name": "Driver" },
            { "name": "{{dynamicMonth-4}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-3}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-2}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-1}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+1}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+2}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+3}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+4}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+5}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+6}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+7}}", "columnsMenuParams": "middleColumns" },
            { "name": "", "columnsMenuParams": "fixedColumns" },
            { "name": "Allocation Method", "columnsMenuParams": "action" },
            { "name": "Forecast", "editable": false },
            { "name": "Value", "editable": false }
          ],
          "month": [
            "{{dynamicMonth-4}}", "{{dynamicMonth-3}}", "{{dynamicMonth-2}}", "{{dynamicMonth-1}}",
            "{{dynamicMonth}}", "{{dynamicMonth+1}}", "{{dynamicMonth+2}}", "{{dynamicMonth+3}}",
            "{{dynamicMonth+4}}", "{{dynamicMonth+5}}", "{{dynamicMonth+6}}", "{{dynamicMonth+7}}"
          ]
        },
        "isApplied": true
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extract": {
        "foreCastBeforeFilter": "rowData.{{dynamicMonth-1}}.forecast"
      }
    },
    {
      "testStep": "Call getMyKPI API with filter applied",
      "environment": "qa",
      "labels": ["smoke","IBGROW-36348","MS3"],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "validate getMyKPI API after filter",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "scenario_id": "{{getkpi3_scenario_id}}",
        "scenario_version": "{{getkpi3_scenario_version}}",
        "dim_id": 11,
        "dim_val_id": 110009,
        "classification_id": 12,
        "template_id": 3,
        "filters": [
          {
            "dim_id": 24,
            "dim_val_ids": [240002],
            "children": []
          }
        ],
        "additional_filters": {
          "pivot_cols": ["month"],
          "pivot_index": ["node_id"],
          "period_view": ["month"],
          "nodes": ["membershipincome_input"],
          "template_include_headers": [
            { "name": "Driver" },
            { "name": "{{dynamicMonth-4}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-3}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-2}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-1}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+1}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+2}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+3}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+4}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+5}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+6}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+7}}", "columnsMenuParams": "middleColumns" },
            { "name": "", "columnsMenuParams": "fixedColumns" },
            { "name": "Allocation Method", "columnsMenuParams": "action" },
            { "name": "Forecast", "editable": false },
            { "name": "Value", "editable": false }
          ],
          "month": [
            "{{dynamicMonth-4}}", "{{dynamicMonth-3}}", "{{dynamicMonth-2}}", "{{dynamicMonth-1}}",
            "{{dynamicMonth}}", "{{dynamicMonth+1}}", "{{dynamicMonth+2}}", "{{dynamicMonth+3}}",
            "{{dynamicMonth+4}}", "{{dynamicMonth+5}}", "{{dynamicMonth+6}}", "{{dynamicMonth+7}}"
          ]
        },
        "isApplied": true
      },
      "extract": {
        "foreCastAfterFilter": "rowData.{{dynamicMonth-1}}.forecast"
      },
      "assertions": [
        {
          "status": 200
        },
        {
        "assertApproxEquals": {
        "jsonPath": "{{foreCastBeforeFilter}}",
        "expected": "{{foreCastAfterFilter}}",
        "acceptedDifference": 0.1000
        }
        }
      ]
    }
  ]
}
