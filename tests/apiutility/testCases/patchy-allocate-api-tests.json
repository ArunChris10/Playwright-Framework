{
    "Verify allocation method is working fine on edited blank cells": [
    {
      "testStep": "Get forecast for KPI filters",
      "environment": "qa",
      "labels": ["smoke", "patchy"],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get forecast for KPI filters",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 11,
        "dim_val_id": 1110029,
        "classification_id": 12,
        "template_id": 3,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "getkpi3_scenario_id": "rowData.scenarioId",
        "getkpi3_scenario_version": "rowData.scenarioVersion"
      }
    },
  
    {
      "testStep": "Call getMyKPI API for patchy forecast month",
      "environment": "qa",
      "labels": ["smoke","patchy"],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "validate getMyKPI API before filter",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "scenario_id": "{{getkpi3_scenario_id}}",
        "scenario_version": "{{getkpi3_scenario_version}}",
        "dim_id": 11,
        "dim_val_id": 110029,
        "classification_id": 12,
        "template_id": 3,
        "filters": [],
        "additional_filters": {
          "pivot_cols": ["month"],
          "pivot_index": ["node_id"],
          "period_view": ["month"],
          "nodes": ["moecommreturnscsatrans"],
          "template_include_headers": [
            { "name": "Driver" },
            { "name": "{{dynamicMonth-4}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-3}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-2}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth-1}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+1}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+2}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+3}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+4}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+5}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+6}}", "columnsMenuParams": "middleColumns" },
            { "name": "{{dynamicMonth+7}}", "columnsMenuParams": "middleColumns" },
            { "name": "", "columnsMenuParams": "fixedColumns" },
            { "name": "Allocation Method", "columnsMenuParams": "action" },
            { "name": "Forecast", "editable": false },
            { "name": "Value", "editable": false }
          ],
          "month": [
            "{{dynamicMonth-4}}", "{{dynamicMonth-3}}", "{{dynamicMonth-2}}", "{{dynamicMonth-1}}",
            "{{dynamicMonth}}", "{{dynamicMonth+1}}", "{{dynamicMonth+2}}", "{{dynamicMonth+3}}",
            "{{dynamicMonth+4}}", "{{dynamicMonth+5}}", "{{dynamicMonth+6}}", "{{dynamicMonth+7}}"
          ]
        },
        "isApplied": true
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extract": {
        "forecastBeforeEditing": "rowData.202610.forecast"
      }
    },


    {
      "testStep": "Editing and Calculating the edited patchy month",
      "environment": "qa",
      "labels": ["smoke", "patchy"],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Calculating the non-additive nodes",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [],
        "scenario_id": "{{getkpi3_scenario_id}}",
        "dim_val_id": 110027,
        "dim_id": 11,
        "preview": true,
        "edits": [
          {
            "node_var_name": "moecommreturnscsatrans",
            "node_dimension": {},
            "data": { "202610": 100 },
            "allocation": { "interval": null, "offset": null, "method": 29 }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 1750781623574
      },
      "assertions": [
        {
          "status": 200
        }
        
      ]
    }
  ]

}