{
  "verify calculate and save for additive and non additive nodes in a SBA": [
    {
      "testStep": "Get a forecast to calculate for additive and non-additive nodes",
      "environment": "qa",
      "labels": ["smoke", "additive_non_additive_calculate_equal_distribution"],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get a forecast to calculate at lower grain",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120011,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelativeMultipleCondition": {
        "scenario_id": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110030
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioId"
        },
        "scenarioVersion": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110030
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioVersion"
        }
      }
    },
    {
      "testStep": "Editing and Calculating the additive and non additive nodes",
      "environment": "qa",
      "labels": ["smoke", "additive_non_additive_calculate_equal_distribution"],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Calculating the additive and non additive nodes",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [
           "financialservicesincome",
          "instorereturnspctofgrossgmv"
        ],
        "scenario_id": "{{scenario_id}}",
        "dim_val_id": 110030,
        "dim_id": 11,
        "preview": true,
        "edits": [
          {
            "node_var_name": "financialservicesincome",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 101172355
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 31
            }
          },
          {
            "node_var_name": "instorereturnspctofgrossgmv",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 1
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 31
            }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 1748928560523
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertNotNull": {
            "jsonPath1": "node_var_name"
          }
        }
      ]
    },
    {
      "testStep": "Saving the adjustment after calculating the additive and non additive nodes",
      "environment": "qa",
      "labels": ["smoke", "additive_non_additive_calculate_equal_distribution"],
      "service": "coreService",
      "uri": "saveAdjustment",
      "testName": "Save the calculation for all the additive and non additive nodes in the SBA",
      "queryParams": "",
      "method": "PATCH",
      "payload": {
        "adjustment_metadata": {
          "adjustment_name": "demo_test_additive_non_additive {{randomNumber}}",
          "adjustment_reason": "",
          "adjustment_type": 74,
          "is_duplicated": false,
          "is_update": false,
          "is_create": true,
          "adjustment_edits": 16,
          "scenario_id": "{{scenario_id}}",
          "scenario_version_timestamp": "{{scenarioVersion}}"
        },
        "allocation_request": {
          "display_nodes": [],
          "scenario_id": "{{scenario_id}}",
          "dim_val_id": 110030,
          "dim_id": 11,
          "preview": false,
          "edits": [
            {
              "node_var_name": "financialservicesincome",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 101172355
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 31
              }
            },
            {
              "node_var_name": "instorereturnspctofgrossgmv",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 1
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 31
              }
            }
          ],
          "filters": [],
          "period_view": "month"
        },
        "dim_val_id": 110030
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "New adjustment created successfully!!"
          }
        }
      ]
    }
  ]
}
