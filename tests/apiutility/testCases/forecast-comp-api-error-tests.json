{
    "validate_forecast_comparison_with_error": [
        {
            "testStep": "Get forecast for KPI filters",
            "environment": "qa",
            "labels": [
                "smoke",
                "forecast_comp_error"
            ],
            "service": "coreService",
            "uri": "getForecast",
            "testName": "Get forecast for KPI filters for forecast comparison",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "unit": "Millions",
                "dim_id": 12,
                "dim_val_id": 120006,
                "classification_id": 12,
                "template_id": 1,
                "filters": [],
                "additional_filters": {
                    "template_include_headers": [
                        {
                            "name": "vs LY",
                            "format": "percent"
                        },
                        {
                            "name": "vs Plan",
                            "format": "absolute"
                        }
                    ]
                }
            },
            "assertions": [
                {
                    "status": 200
                }
            ],
            "extractRelative": {
                "getkpi2_scenario_id": {
                    "whereKey": "rowData.lineOfBusiness",
                    "equals": 110009,
                    "extractKey": "rowData.scenarioId"
                },
                "getkpi2_scenario_version": {
                    "whereKey": "rowData.lineOfBusiness",
                    "equals": 110009,
                    "extractKey": "rowData.scenarioVersion"
                }
            }
        },
