{
  "validate_excel_load-data": [
   
    {
      "testStep": "Extract scenario version from get-report API",
      "environment": "qa",
      "labels": ["smoke", "get-report","Pallavi"],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get scenarios ID and version for excel",
      "queryParams": "",
      "method": "POST",
      "payload":{
        "classification_id": 12,
        "dim_id": 12,
        "dim_val_id": 120010,
        "template_id": 1
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "scenario_version_timestamp": "rowData.scenarioVersion",       
        "scenario_id": "rowData.scenarioId",
        "forecast_scenario_id":"rowData.FTS",
        "actual_scenario_id":"rowData.ATS"
      }
    },
    {
      "testStep": "validate Load data with empty dimensions value",
      "environment": "qa",
      "labels": ["smoke", "excel","IBG-37167","Pallavi"],
      "service": "reportingService",
      "uri": "scenarios",
      "queryParams": "",
      "testName": "validate Load data with empty dimensions value",
      "method": "POST",
      "payload": {
        "nodeIds": [
          "momerchandisesales",
          "mowarehouseallowances",
          "mobuyingallowances",
          "mototalallowances",
          "mopostaudit",
          "moimportallowances",
          "moothercostofsales"
        ],
        "scenarios": [
          {
            "scenarioId": "{{scenario_id}}",
            "scenarioVer": "{{scenario_version_timestamp}}",
            "actual_scenario_id": "{{actual_scenario_id}}",
            "forecast_scenario_id": "{{forecast_scenario_id}}",
            "type": "scenarios"
              }
        ],
        "filters": {
          "department": [
            80,
            83,
            93
          ]
        },
        "hierarchy_names": [
          "MP_CHANNEL_LEVELS",
          "SBU"
        ],
        "periods": [
          "{{dynamicMonth-3}}",
          "{{dynamicMonth-2}}",
          "{{dynamicMonth-1}}",
          "{{dynamicMonth}}",
          "{{dynamicMonth+1}}",
          "{{dynamicMonth+2}}",
          "{{dynamicMonth+3}}",
          "{{dynamicMonth+4}}",
          "{{dynamicMonth+5}}",
          "{{dynamicMonth+6}}",
          "{{dynamicMonth+7}}"
        ],
        "aggregationLevel": [
          "MONTH"
        ],
        "dimensions": [],
        "pivot_rows": [
          "Node Name"
        ],
        "pivot_columns": [
          "Date",
          "Scenario Name"
        ]
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "rowData.Node Name",
            "value1": "grossprofit"
          }
        }
      ]
    },
    {
