{
  "validate_excel_load_data_aggregation": [
    {
      "testStep": "Extract scenario",
      "environment": "qa",
      "labels": [
        "smoke",
        "regression",
        "excelplugin",
        "@ibg-ufm-domino-service",
        "@ibg-ufm-metadata-service",
        "@ibg-ufm-adjustment-proxy",
        "@ibg-ufm-adjustment-orchestrator",
        "@@ibg-ufm-reporting-proxy",
        "@ibg-ufm-adjustments",
        "@ibg-ufm-reporting"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get scenarios for excel",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "classification_id": 12,
        "dim_id": 12,
        "dim_val_id": 120010,
        "template_id": 1
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "excel_scenario_version_timestamp": "rowData.scenarioVersion",
        "excel_scenario_id": "rowData.scenarioId",
        "excel_actual_template_id": "rowData.ATS",
        "excel_forecast_template_id": "rowData.FTS"
      }
    },
    {
      "testStep": "Get no filter total",
      "testName": "Get no filter total",
      "environment": "qa",
      "labels": [
        "smoke",
        "regression",
        "IBGROW-37182",
        "elliot"
      ],
      "service": "reportingService",
      "uri": "scenarios",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "node_var_names": [
          "momerchandisesales"
        ],
        "scenarios": [
          {
            "scenario_id": "{{excel_scenario_id}}",
            "scenario_ver": "{{excel_scenario_version_timestamp}}",
            "actual_scenario_id": "{{excel_actual_template_id}}",
            "forecast_scenario_id": "{{excel_forecast_template_id}}",
            "type": "scenarios"
          }
        ],
        "filters": {},
        "hierarchy_names": [
          "MP_CHANNEL_LEVELS",
          "SBU"
        ],
        "periods": [
          "{{dynamicMonth}}"
        ],
        "period_type": "month",
        "period_levels": [],
        "dimensions": [],
        "pivot_rows": [
          "scenario_id",
          "month"
        ],
        "pivot_columns": [
          "node_var_name"
        ]
      },
      "extractFirst": {
        "no_filter_total": "row_data.momerchandisesales"
      }
    },
    {
