          "{{dynamicMonth+3}}",
          "{{dynamicMonth+4}}",
          "{{dynamicMonth+5}}",
          "{{dynamicMonth+6}}"
        ],
        "period_type": "month",
        "period_levels": [],
        "dimensions": [
          "channel_l3",
          "channel_l2",
          "channel_l1"
        ],
        "pivot_rows": [
          "node_var_name",
          "channel_l3",
          "channel_l1",
          "channel_l2"
        ],
        "pivot_columns": [
          "month",
          "scenario_id"
        ]
      },
      "assertions": [
        {
          "status": 200
        }
      ]
    },
