{
  "validate_excel_load_data": [
    {
      "testStep": "Extract scenario",
      "environment": "qa",
      "labels": [
        "smoke",
        "regression",
        "excelplugin",
        "@ibg-ufm-domino-service",
        "@ibg-ufm-metadata-service",
        "@ibg-ufm-adjustment-proxy",
        "@ibg-ufm-adjustment-orchestrator",
        "@@ibg-ufm-reporting-proxy",
        "@ibg-ufm-adjustments",
        "@ibg-ufm-reporting"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get scenarios for excel",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "classification_id": 12,
        "dim_id": 12,
        "dim_val_id": 120010,
        "template_id": 1
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "listHistoricals_scenario_version_timestamp": "rowData.scenarioVersion",
        "listHistoricals_scenario_id": "rowData.scenarioId",
        "listHistoricals_actual_template_id": "rowData.ATS",
        "listHistoricals_forecast_template_id": "rowData.FTS"
      }
    },
