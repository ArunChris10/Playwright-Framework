      "queryParams": "",
      "payload": {
        "display_nodes": [],
        "scenario_id": "{{asyncRefreshNode_scenario_id}}",
        "dim_val_id": 110021,
        "dim_id": 11,
        "preview": true,
        "edits": [
          {
            "node_var_name": "pharmacyincentiveexpensepk0203",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+2}}": 4020
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          },
          {
            "node_var_name": "fieldincentiveexpensepk0202",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+2}}": 8550
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          },
          {
            "node_var_name": "longtermbonuspk0201",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+2}}": 9060
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 1747291738569
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "fieldincentiveexpenseEdit": {
          "whereKey": "node_var_name",
          "equals": "fieldincentiveexpensepk0202",
          "extractKey": "edits.{{dynamicMonth+2}}.forecast"
        },
        "longtermbonusEdit": {
          "whereKey": "node_var_name",
          "equals": "longtermbonuspk0201",
          "extractKey": "edits.{{dynamicMonth+2}}.forecast"
        },
        "pharmacyincentiveexpenseEdit": {
          "whereKey": "node_var_name",
          "equals": "pharmacyincentiveexpensepk0203",
          "extractKey": "edits.{{dynamicMonth+2}}.forecast"
        }
      }
    },
