              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelativeMultipleCondition": {
        "IOtoDeletescenarioId_multipltLayerSave": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110026
            },
            {
              "path": "rowData.owner",
              "equals": "LB-ibg-ufm-auto"
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioId"
        },
        "IOtoDeletescenarioVersion_multipltLayerSave": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110026
            },
            {
              "path": "rowData.owner",
              "equals": "LB-ibg-ufm-auto"
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
