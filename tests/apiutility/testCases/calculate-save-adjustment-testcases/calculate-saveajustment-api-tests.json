{
  "createScenario_for_various_node_types": [
    {
      "testStep": "Create Forecast Scenario for IO SBA to have combination of #, %, and $ Node Types",
      "environment": "qa",
      "labels": [
        "smoke",
        "Pre-Req",
        "ibg-ufm-domino-service",
        "ibg-ufm-metadata-service",
        "ibg-ufm-core-service",
        "ibg-ufm-allocation-engine"
      ],
      "service": "coreService",
      "uri": "Forecast",
      "testName": "Validate create forecast- IO SBA",
      "queryParams": "/create-user-scenario",
      "method": "POST",
      "payload": {
        "type": 3,
        "name": "apiUtilityAutomation {{randomNumber}}",
        "classification_id": 12,
        "dim_id": 11,
        "dim_val_id": 110026
      },
      "extract": {
        "io_scenario_id_multipltNodes": "scenario.scenario_id",
        "io_scenario_version_multipleNodes": "scenario.scenario_version_timestamp"
      },
      "assertions": [
        {
          "status": 200
        }
      ]
    },
    {
      "testStep": "Poll creation of IO FORECAST",
      "environment": "qa",
      "labels": [
        "smoke",
        "Pre-Req"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Poll creation of IO FORECAST",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120009,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "polling": {
        "extractRelative": {
          "WhereKey": "rowData.name",
          "Equals": "apiUtilityAutomation {{randomNumber}}",
          "Findkey": "rowData.forecastStatus.statusCode"
        },
        "expectedValue": 21,
        "intervalMs": 5000,
        "timeoutMs": 600000
      }
    },
    {
      "testStep": "Calculate Forecast for #, %, and $ Node Types",
      "environment": "qa",
      "labels": [
        "smoke",
        "IBGROW-38434",
        "IBGROW-35440",
        "MS1"
      ],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Verify calculation for all node types (#, %, $)",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [],
        "scenario_id": "{{io_scenario_id_multipltNodes}}",
        "dim_val_id": 110026,
        "dim_id": 11,
        "preview": true,
        "edits": [
          {
            "node_var_name": "returnedunitsuom_input",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 532
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          },
          {
            "node_var_name": "storereturns_input",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 500
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          },
          {
            "node_var_name": "allocationpctmerchandiseincome_input",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 1.5
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 1747131515456
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "forecastDriverOne": {
          "whereKey": "node_var_name",
          "equals": "storereturns_input",
          "extractKey": "edits.{{dynamicMonth+1}}.forecast"
        },
        "forecastDriverTwo": {
          "whereKey": "node_var_name",
          "equals": "returnedunitsuom_input",
          "extractKey": "edits.{{dynamicMonth+1}}.forecast"
        },
        "forecastDriverThree": {
          "whereKey": "node_var_name",
          "equals": "merchandiseincomeallocatedtoentity",
          "extractKey": "edits.{{dynamicMonth+1}}.forecast"
        },
        "forecastDriverFour": {
          "whereKey": "node_var_name",
          "equals": "allocationpctmerchandiseincome_input",
          "extractKey": "edits.{{dynamicMonth+1}}.forecast"
        }
      },
      "validateExtractToBeNotNull": [
        "forecastDriverOne",
        "forecastDriverTwo",
        "forecastDriverThree",
        "forecastDriverFour"
      ]
    },
    {
      "testStep": "Save Adjustment for Node Types (#, %, $)",
      "environment": "qa",
      "labels": [
        "smoke",
        "IBGROW-38435",
        "IBGROW-35441",
        "MS1"
      ],
      "service": "coreService",
      "uri": "saveAdjustment",
      "testName": "Verify Save works correctly for all node types (#, %, $)",
      "queryParams": "",
      "method": "PATCH",
      "payload": {
        "adjustment_metadata": {
          "adjustment_name": "test Adjustment",
          "adjustment_reason": "",
          "adjustment_type": 73,
          "is_duplicated": false,
          "is_update": false,
          "is_create": true,
          "adjustment_edits": 3,
          "scenario_id": "{{io_scenario_id_multipltNodes}}",
          "scenario_version_timestamp": "{{io_scenario_version_multipleNodes}}"
        },
        "allocation_request": {
          "display_nodes": [],
          "scenario_id": "{{io_scenario_id_multipltNodes}}",
          "dim_val_id": 110026,
          "dim_id": 11,
          "preview": false,
          "edits": [
            {
              "node_var_name": "returnedunitsuom_input",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 532
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            },
            {
              "node_var_name": "storereturns_input",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 500
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            },
            {
              "node_var_name": "allocationpctmerchandiseincome_input",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 1.5
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            }
          ],
          "filters": [],
          "period_view": "month"
        },
        "dim_val_id": 110026
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "New adjustment created successfully!!",
            "jsonPath2": "adjustment_metadata.adjustment_name",
            "value2": "test Adjustment"
          },
          "assertNotNull": {
            "jsonPath1": "adjustment_metadata.adjustment_id",
            "jsonPath2": "adjustment_metadata.created_by",
            "jsonPath3": "adjustment_metadata.created_at"
          }
        }
      ]
    },
    {
      "testStep": "Calculate Forecast for for Nonadditive- % rolling",
      "environment": "qa",
      "labels": [
        "smoke",
        "IBGROW-36529",
        "MS1"
      ],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Verify calculation for for Nonadditive- % rolling",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [
          "merchandiseincomeallocatedtoentity",
          "merchandiseincomecalculated"
        ],
        "scenario_id": "{{io_scenario_id_multipltNodes}}",
        "dim_val_id": 110026,
        "dim_id": 11,
        "preview": true,
        "edits": [
          {
            "node_var_name": "allocationpctmerchandiseincome_input",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+3}}": 6.52
            },
            "allocation": {
              "interval": 2,
              "offset": 3,
              "method": 32
            }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 1747131515456
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "nonadditiveNode": {
          "whereKey": "node_var_name",
          "equals": "allocationpctmerchandiseincome_input",
          "extractKey": "edits.{{dynamicMonth+3}}.forecast"
        },
        "NonAdditiveinputNodeOne": {
          "whereKey": "node_var_name",
          "equals": "merchandiseincomeallocatedtoentity",
          "extractKey": "edits.{{dynamicMonth+3}}.forecast"
        },
        "NonAdditiveinputNodeTwo": {
          "whereKey": "node_var_name",
          "equals": "merchandiseincomecalculated",
          "extractKey": "edits.{{dynamicMonth+3}}.forecast"
        }
      },
      "validateExtractToBeNotNull": [
        "nonadditiveNode",
        "NonAdditiveinputNodeOne",
        "NonAdditiveinputNodeTwo"
      ]
    },
