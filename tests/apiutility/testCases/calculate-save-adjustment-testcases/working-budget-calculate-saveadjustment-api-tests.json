{
  "get_workingBudget_and_save_equalDistribution_adjustment": [
    {
      "testStep": "Get working budget scenario, calculate and save adjustment using equal distribution , test vsPlan % and vsLy value",
      "environment": "qa",
      "labels": [
        "smoke",
        "regression",
        "working-budget",
        "ibg-ufm-domino-service",
        "ibg-ufm-metadata-service",
        "ibg-ufm-core-service",
        "ibg-ufm-allocation-engine"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get scenario for working budget",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "classification_id": 12,
        "dim_id": 12,
        "dim_val_id": 120010,
        "template_id": 1
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "workingBudget_scenario_version_timestamp": {
          "whereKey": "rowData.typeId",
          "equals": 88,
          "extractKey": "rowData.scenarioVersion"
        },
        "workingBudget_scenario_id": {
          "whereKey": "rowData.typeId",
          "equals": 88,
          "extractKey": "rowData.scenarioId"
        }
      }
    },
    {
      "testStep": "Calculate working budget calculation and save for equal distribution",
      "environment": "qa",
      "labels": [
        "smoke",
        "working-budget"
      ],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Verify working budget calculation for equal distribution",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [],
        "scenario_id": "{{workingBudget_scenario_id}}",
        "dim_val_id": 110029,
        "dim_id": 11,
        "preview": true,
        "edits": [
          {
            "node_var_name": "molevelofcalc_input",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 111
            },
            "allocation": {
              "method": 31
            }
          }
        ],
        "filters": [
          {
            "dim_id": 1,
            "dim_val_ids": [
              2,
              4,
              8,
              13,
              1,
              80,
              83,
              93,
              14,
              17,
              19,
              20,
              3,
              9,
              10,
              11,
              12,
              16,
              5,
              6,
              7,
              18
            ],
            "children": []
          }
        ],
        "period_view": "month",
        "forecast_months_selected": [
          "{{dynamicMonth}}",
          "{{dynamicMonth+1}}",
          "{{dynamicMonth+2}}",
          "{{dynamicMonth+3}}",
          "{{dynamicMonth+4}}",
          "{{dynamicMonth+5}}",
          "{{dynamicMonth+6}}",
          "{{dynamicMonth+7}}",
          "{{dynamicMonth+8}}",
          "{{dynamicMonth+9}}",
          "{{dynamicMonth+10}}",
          "{{dynamicMonth+11}}"
        ],
        "adjustment_id": 1754081191221
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "forecastDriverOne": {
          "whereKey": "node_var_name",
          "equals": "molevelofcalc_input",
          "extractKey": "edits.{{dynamicMonth+1}}.forecast"
        }
      },
      "validateExtractToBeNotNull": [
        "forecastDriverOne"
      ]
    },
    {
      "testStep": "Save Adjustment for working budget",
      "environment": "qa",
      "labels": [
        "smoke"
      ],
      "service": "coreService",
      "uri": "saveAdjustment",
      "testName": "Verify Save works correctly for all node types (#, %, $)",
      "queryParams": "",
      "method": "PATCH",
      "payload": {
        "adjustment_metadata": {
          "adjustment_name": "test Adjustment",
          "adjustment_reason": "",
          "adjustment_type": 73,
          "is_duplicated": false,
          "is_update": false,
          "is_create": true,
          "adjustment_edits": 3,
          "scenario_id": "{{workingBudget_scenario_id}}",
          "scenario_version_timestamp": "{{workingBudget_scenario_version_timestamp}}"
        },
        "allocation_request": {
          "display_nodes": [],
          "scenario_id": "{{workingBudget_scenario_id}}",
          "dim_val_id": 110029,
          "dim_id": 11,
          "preview": false,
          "edits": [
            {
              "node_var_name": "molevelofcalc_input",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 532
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 31
              }
            },
            {
              "node_var_name": "moothernonstorereceipts",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 500
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            },
            {
              "node_var_name": "mobuyingallowances",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 1.5
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            }
          ],
          "filters": [],
          "period_view": "month"
        },
        "dim_val_id": 110029
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "New adjustment created successfully!!",
            "jsonPath2": "adjustment_metadata.adjustment_name",
            "value2": "test Adjustment"
          },
          "assertNotNull": {
            "jsonPath1": "adjustment_metadata.adjustment_id",
            "jsonPath2": "adjustment_metadata.created_by",
            "jsonPath3": "adjustment_metadata.created_at"
          }
        }
      ]
    },
    {
      "testStep": "Get working budget forecast with vsPlan percentage and vsLY value validation",
      "environment": "qa",
      "labels": [
        "smoke",
        "working-budget"
      ],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "Verify working budget calculation for equal distribution",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "baseURL": "https://ibg-ufm-core-service.qa.ibg.walmart.com/reports/get-mykpi/v2",
        "scenario_id": "{{workingBudget_scenario_id}}",
        "scenario_version": "{{workingBudget_scenario_version_timestamp}}",
        "dim_id": 11,
        "dim_val_id": 110029,
        "classification_id": 12,
        "template_id": 3,
        "filters": [
          {
            "dim_id": 1,
            "dim_val_ids": [
              2,
              4,
              8,
              13,
              1,
              80,
              83,
              93,
              14,
              17,
              19,
              20,
              3,
              9,
              10,
              11,
              12,
              16,
              5,
              6,
              7,
              18
            ],
            "children": []
          }
        ],
        "additional_filters": {
          "pivot_cols": [
            "month"
          ],
          "pivot_index": [
            "node_id"
          ],
          "period_view": [
            "month"
          ],
          "nodes": [
            "molevelofcalc_input"
          ],
          "template_include_headers": [
            {
              "name": "vs Plan",
              "format": "percent"
            },
            {
              "name": "vs LY",
              "format": "absolute"
            },
            {
              "name": "{{dynamicMonth}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+1}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+2}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+3}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+4}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+5}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+6}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+7}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+8}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+9}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+10}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "{{dynamicMonth+11}}",
              "columnsMenuParams": "middleColumns"
            },
            {
              "name": "",
              "columnsMenuParams": "fixedColumns"
            },
            {
              "name": "Allocation Method",
              "columnsMenuParams": "action"
            },
            {
              "name": "Forecast",
              "editable": true
            },
            {
              "name": "Value",
              "editable": true
            }
          ],
          "month": [
            "{{dynamicMonth}}",
            "{{dynamicMonth+1}}",
            "{{dynamicMonth+2}}",
            "{{dynamicMonth+3}}",
            "{{dynamicMonth+4}}",
            "{{dynamicMonth+5}}",
            "{{dynamicMonth+6}}",
            "{{dynamicMonth+7}}",
            "{{dynamicMonth+8}}",
            "{{dynamicMonth+9}}",
            "{{dynamicMonth+10}}",
            "{{dynamicMonth+11}}"
          ]
        },
        "isApplied": true
      },
      "extractRelative": {
        "vsLyAbsolute": {
          "whereKey": "driver",
          "equals": "molevelofcalc_input",
          "extractKey": "{{dynamicMonth}}.vsLyAbsolute"
        },
        "vsPlanPercentage": {
          "whereKey": "driver",
          "equals": "molevelofcalc_input",
          "extractKey": "{{dynamicMonth}}.vsPlanPercent"
        }
      },
      "validateExtractToBeNotNull": [
        "vsLyAbsolute",
        "vsPlanPercentage"
      ],
      "validateExtractToBeApprox": {
        "vsLyAbsolute": {
          "expected": 0,
          "tolerance": 0
        }
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertNotNull": {
            "jsonPath1": "vsPlanPercentage"
          }
        }
      ]
    }
  ]
}