{
  "Validate-calculate-save-non-additive-node-workflow": [
    {
            "runInParallel": false,
      "testStep": "Get a forecast to delete before proceding for IO SBA",
      "environment": "qa",
      "labels": [
        "smoke",
        "MS2"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get a forecast to delete before proceding for Io SBA",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120009,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelativeMultipleCondition": {
        "IOtoDeletescenarioId": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110026
            },
            {
              "path": "rowData.owner",
              "equals": "LB-ibg-ufm-auto"
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioId"
        },
        "IOtoDeletescenarioVersion": {
          "conditions": [
            {
              "path": "rowData.lineOfBusiness",
              "equals": 110026
            },
            {
              "path": "rowData.owner",
              "equals": "LB-ibg-ufm-auto"
            },
            {
              "path": "rowData.forecastStatus.statusCode",
              "equals": 21
            }
          ],
          "extractKey": "scenarioVersion"
        }
      }
    },
    {
      "testStep": "Delete IO SBA forecast before proceding",
      "environment": "qa",
      "labels": [
        "smoke","MS2"
      ],
      "service": "coreService",
      "uri": "Forecast",
      "testName": "Delete a IO forecast before proceding",
      "queryParams": "/{{IOtoDeletescenarioId}}/{{IOtoDeletescenarioVersion}}",
      "method": "DELETE",
      "payload": {
        "dim_id": 11,
        "dim_val_id": 110026
      }
    },
    {
      "testStep": "Create Forecast Scenario for IO SBA to have combination of #, %, and $ Node Types",
      "environment": "qa",
      "labels": [
        "smoke",
        "Pre-Req","MS2"
      ],
      "service": "coreService",
      "uri": "Forecast",
      "testName": "Validate create forecast- IO SBA",
      "queryParams": "/create-user-scenario",
      "method": "POST",
      "payload": {
        "type": 3,
        "name": "apiUtilityAutomation {{randomNumber}}",
        "classification_id": 12,
        "dim_id": 11,
        "dim_val_id": 110026
      },
      "extract": {
        "io_scenario_id": "scenario.scenario_id",
        "io_scenario_version": "scenario.scenario_version_timestamp"
      },
      "assertions": [
        {
          "status": 200
        }
      ]
    },
    {
      "testStep": "Poll creation of IO FORECAST",
      "environment": "qa",
      "labels": [
        "smoke",
        "Pre-Req","MS2"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Poll creation of IO FORECAST",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120009,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "polling": {
        "extractRelative": {
          "WhereKey": "rowData.name",
          "Equals": "apiUtilityAutomation {{randomNumber}}",
          "Findkey": "rowData.forecastStatus.statusCode"
        },
        "expectedValue": 21,
        "intervalMs": 5000,
        "timeoutMs": 600000
      }
    }
  ,
    {
      "testStep": "Apply Allocation on Non-Additive Node with Filters",
      "environment": "qa",
      "labels": ["smoke", "IBGROW-38428", "MS2"],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Verify allocation with filters on non-additive node maintaining ratio",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "adjustment_id": 1747138163432,
        "dim_id": 11,
        "dim_val_id": 110027,
        "display_nodes": [],
        "edits": [
          {
            "node_var_name": "allocationpctmerchandiseincome_input",
            "node_dimension": {
              "department": 1
            },
            "data": {
              "{{dynamicMonth+1}}": 0.89
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          }
        ],
        "filters": [
          {
            "dim_id": 1,
            "dim_val_ids": [1],
            "children": []
          }
        ],
        "period_view": "month",
        "preview": true,
        "scenario_id": "{{io_scenario_id}}"
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "node_var_name",
            "value1": "merchandiseincomeallocatedtoentity"
          }
        },
        {
          "extractRelative": {
            "forecastDriverOne": {
              "whereKey": "node_var_name",
              "equals": "merchandiseincomeallocatedtoentity",
              "extractKey": "edits.{{dynamicMonth+1}}.forecast"
            },
            "forecastDriverTwo": {
              "whereKey": "node_var_name",
              "equals": "allocationpctmerchandiseincome_input",
              "extractKey": "edits.{{dynamicMonth+1}}.forecast"
            }
          },
          "validateExtract": {
            "forecastDriverOne": -62351.1661,
            "forecastDriverTwo": 0.89
          }
        }
      ]
    },
    {
      "testStep": "Save Adjustment with Filters on Non-Additive Node",
      "environment": "qa",
      "labels": ["smoke", "IBGROW-38429", "MS2"],
      "service": "coreService",
      "uri": "saveAdjustment",
      "testName": "Verify save works with filters on non-additive node maintaining ratio",
      "queryParams": "",
      "method": "PATCH",
      "payload": {
        "adjustment_metadata": {
          "adjustment_name": "test Adjustment",
          "adjustment_reason": "to check save Adjustment",
          "adjustment_type": 74,
          "is_duplicated": false,
          "is_update": false,
          "is_create": true,
          "adjustment_edits": 1,
          "scenario_id": "{{io_scenario_id}}",
          "scenario_version_timestamp": "{{io_scenario_version}}"
        },
        "allocation_request": {
          "display_nodes": [],
          "scenario_id": "{{io_scenario_id}}",
          "dim_val_id": 110027,
          "dim_id": 11,
          "preview": false,
          "edits": [
            {
              "node_var_name": "allocationpctmerchandiseincome_input",
              "node_dimension": {
                "department": 1
              },
              "data": {
                "{{dynamicMonth+1}}": 0.89
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            }
          ],
          "filters": [
            {
              "dim_id": 1,
              "dim_val_ids": [1],
              "children": []
            }
          ],
          "period_view": "month"
        },
        "dim_val_id": 110027
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "New adjustment created successfully!!",
            "jsonPath2": "adjustment_metadata.adjustment_name",
            "value2": "test Adjustment"
          },
          "assertNotNull": {
            "jsonPath1": "adjustment_metadata.adjustment_id",
            "jsonPath2": "adjustment_metadata.created_by",
            "jsonPath3": "adjustment_metadata.created_at"
          }
        }
      ]
    }
  ]
}
