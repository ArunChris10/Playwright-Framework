    },
    {
      "testStep": "Poll the creation of source scenario",
      "environment": "qa",
      "labels": [
        "smoke",
        "copy_scenario_draft_source_select_drivers"
      ],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Poll the creation of source scenario",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120006,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "sourceATS": {
          "whereKey": "rowData.name",
          "equals": "Test-source-{{randomNumber}}",
          "extractKey": "rowData.ATS"
        },
        "sourceFTS": {
          "whereKey": "rowData.name",
          "equals": "Test-source-{{randomNumber}}",
          "extractKey": "rowData.FTS"
        }
      },
      "polling": {
        "extractRelative": {
          "WhereKey": "rowData.name",
          "Equals": "Test-source-{{randomNumber}}",
          "Findkey": "rowData.forecastStatus.statusCode"
        },
        "expectedValue": 21,
        "intervalMs": 5000,
        "timeoutMs": 600000
      }
    },
