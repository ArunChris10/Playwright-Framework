{
    "Verify allocation method is working fine on edited blank cells": [
        {
            "testStep": "Create Forecast Scenario for Merchops SBA",
            "environment": "qa",
            "labels": [
                "smoke",
                "patchy",
                "ibg-ufm-domino-service",
                "ibg-ufm-metadata-service",
                "ibg-ufm-core-service",
                "ibg-ufm-allocation-engine"
            ],
            "service": "coreService",
            "uri": "Forecast",
            "testName": "create forecast- Merchops SBA",
            "queryParams": "/create-user-scenario",
            "method": "POST",
            "payload": {
                "type": 3,
                "name": "Patchy_Testing_{{randomNumber}}",
                "classification_id": 12,
                "dim_id": 11,
                "dim_val_id": 110029
            },
            "extract": {
                "merchops_scenario_id": "scenario.scenario_id",
                "merchops_scenario_version": "scenario.scenario_version_timestamp"
            },
            "assertions": [
                {
                    "status": 200
                }
            ]
        },
        {
            "testStep": "POLL creation of Merchops FORECAST",
            "environment": "qa",
            "labels": [
                "smoke",
                "Pre-Req"
            ],
            "service": "coreService",
            "uri": "getForecast",
            "testName": "POLL creation of Merchops FORECAST",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "unit": "Millions",
                "dim_id": 11,
                "dim_val_id": 110029,
                "classification_id": 12,
                "template_id": 1,
                "filters": [],
                "additional_filters": {
                    "template_include_headers": [
                        {
                            "name": "vs LY",
                            "format": "percent"
                        },
                        {
                            "name": "vs Plan",
                            "format": "absolute"
                        }
                    ]
                }
            },
            "assertions": [
                {
                    "status": 200
                }
            ],
            "polling": {
                "extractRelative": {
                    "WhereKey": "rowData.name",
                    "Equals": "Patchy_Testing_{{randomNumber}}",
                    "Findkey": "rowData.forecastStatus.statusCode"
                },
                "expectedValue": 21,
                "intervalMs": 5000,
                "timeoutMs": 600000
            }
        },
