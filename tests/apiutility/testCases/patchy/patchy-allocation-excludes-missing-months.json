      "service": "coreService",
      "uri": "getForecast",
      "testName": "Get forecast for KPI filters for forecast comparison",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "unit": "Millions",
        "dim_id": 12,
        "dim_val_id": 120009,
        "classification_id": 12,
        "template_id": 1,
        "filters": [],
        "additional_filters": {
          "template_include_headers": [
            {
              "name": "vs LY",
              "format": "percent"
            },
            {
              "name": "vs Plan",
              "format": "absolute"
            }
          ]
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "getkpi2_scenario_id": "rowData.scenarioId",
        "getkpi2_scenario_version": "rowData.scenarioVersion"
      }
    },
