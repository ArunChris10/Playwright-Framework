        {
            "testStep": "Editing and Calculating the edited patchy dependent node",
            "environment": "qa",
            "labels": [
                "smoke",
                "patchy_multiple_non_additive"
            ],
            "service": "coreService",
            "uri": "allocateData",
            "testName": "Editing and Calculating the edited patchy month",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "display_nodes": [
                    "unitsnetuom",
                    "scannedunitsibgdemand",
                    "merchandiseincomeallocatedtoentity",
                    "merchandiseincomechanneldept_calculated"
                ],
                "dim_val_id": 110027,
                "dim_id": 11,
                "preview": true,
                "edits": [
                    {
                        "node_var_name": "uompctofscannednet_input",
                        "node_dimension": {},
                        "data": {
                            "202610": 100
                        },
                        "allocation": {
                            "interval": null,
                            "offset": null,
                            "method": 29
                        }
                    },
                    {
                        "node_var_name": "allocationpctmerchandiseincome_input",
                        "node_dimension": {},
                        "data": {
                            "202610": 200
                        },
                        "allocation": {
                            "interval": null,
                            "offset": null,
                            "method": 29
                        }
                    }
                ],
                "filters": [],
                "period_view": "month",
                "scenario_id": "{{scheduled_scenario_id}}",
                "adjustment_id": "1751013629991"
            },
            "assertions": [
                {
                    "status": 404
                },
                {
                    "assertEquals": {
                        "messageMultiple": "message",
                        "multipleValue": "UOM % of Scanned (Net) is using an aggregation formula with missing values. Please add data for the missing fields -  'Units (Net UOM)' and 'Scanned Units (IBG Demand)' before calculating.\n\nAllocation % (Merchandise Income) is using an aggregation formula with missing values. Please add data for the missing fields -  'Merchandise Income (allocated to entity)' and 'Merchandise Income (channel, dept)' before calculating."
                    }
                }
            ]
        }
    ]
