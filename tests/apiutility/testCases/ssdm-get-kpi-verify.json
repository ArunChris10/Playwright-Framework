{
    "validate_ssdm_get_kpi": [
        {
            "testStep": "Get Scenario id and scenario version of sandbox scenario",
            "environment": "qa",
            "labels": [
                "smoke",
                "SSDMKPI"
            ],
            "service": "coreService",
            "uri": "getSandboxScenarioId",
            "testName": "Get Scenario id and scenario version of sandbox scenario",
            "queryParams": "",
            "method": "GET",
            "payload": {},
            "assertions": [
                {
                    "status": 200
                }
            ],
            "extractFirst": {
                "getkpi_scenario_id": "scenario_id"
            }
        },
        {
            "testStep": "Get doc id of published version",
            "environment": "qa",
            "labels": [
                "smoke",
                "SSDMKPI"
            ],
            "service": "coreService",
            "uri": "getPublishedVersions",
            "testName": "Get doc id of published version",
            "queryParams": "",
            "method": "GET",
            "payload": {},
            "assertions": [
                {
                    "status": 200
                }
            ],
            "extractFirst": {
                "extracted_doc_id": "published_doc_list.document_id"
            }
        },
        {
            "testStep": "Get Scenario version of sandbox scenario",
            "environment": "qa",
            "labels": [
                "smoke",
                "SSDMKPI"
            ],
            "service": "coreService",
            "uri": "computeSsdm",
            "testName": "Get Scenario version of sandbox scenario",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "scenario_id": "{{getkpi_scenario_id}}",
                "doc_id": "{{extracted_doc_id}}",
                "classification_id": 12,
                "ds_type": "Activated"
            },
            "assertions": [
                {
                    "status": 200
                }
            ],
            "extractFirst": {
                "scenario_version": "scenario_version"
            }
        },
        {
