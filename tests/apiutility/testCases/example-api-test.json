{
  "validate_screen_id_api_response": [
    {
      "testStep": "Validate screen section ID and name",
      "environment": "qa",
      "labels": ["smoke", "login"],
      "service": "coreService",
      "uri": "getScreenId",
      "testName": "Validate screen id API returns correct values",
      "queryParams": "dim_id=12&dim_val_id=120006",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "screen_sec_name",
            "value1": "Inputter",
            "jsonPath2": "screen_sect_id",
            "value2": 103
          },
          "assertNotEquals": {
            "jsonPath": "screen_sec_name",
            "value": "MS3"
          },
          "assertNotNull": {
            "jsonPath": "screen_sec_name"
          },
          "assertResponse": {
            "filePath": "examplePayload.json"
          }
        }
      ]
    }
  ],
    "validate_get_screen_details": [
    {
      "testStep": "Call get screen ID API and extract values",
      "environment": "qa",
      "labels": ["smoke", "login"],
      "service": "coreService",
      "uri": "getScreenId",
      "testName": "Validate get screen details",
      "queryParams": "dim_id=12&dim_val_id=120006",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        }
      ],
      "extract": {
        "screen_id": "screen_id"
      },
      "extractRelative": {
        "screen_sect_id": {
          "whereKey": "screen_sec_name",
          "equals": "Inputter",
          "extractKey": "screen_sect_id"
        }
      }
    },
    {
      "testStep": "Validate extracted screen section and ID",
      "environment": "qa",
      "labels": ["smoke", "login"],
      "service": "coreService",
      "uri": "getScreenId",
      "testName": "Validate extracted screen details",
      "method": "GET",
      "queryParams": "dim_id=12&dim_val_id=120006",
      "assertions": [
        {
          "assertEquals": {
            "jsonPath1": "{{screen_sect_id}}",
            "value1": 101,
            "jsonPath2": "{{screen_id}}",
            "value2": 1
          }
        }
      ]
    }
  ]
}
