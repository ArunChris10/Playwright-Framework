                            "columnsMenuParams": "middleColumns"
                        },
                        {
                            "name": "{{dynamicMonth}}",
                            "columnsMenuParams": "middleColumns"
                        },
                        {
                            "name": "{{dynamicMonth+1}}",
                            "columnsMenuParams": "middleColumns"
                        },
                        {
                            "name": "{{dynamicMonth+2}}",
                            "columnsMenuParams": "middleColumns"
                        },
                        {
