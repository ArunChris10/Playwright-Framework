            ],
            "service": "coreService",
            "uri": "getForecast",
            "testName": "Get forecast for KPI filters for forecast comparison",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "unit": "Millions",
                "dim_id": 12,
                "dim_val_id": 120006,
                "classification_id": 12,
                "template_id": 1,
                "filters": [],
                "additional_filters": {
                    "template_include_headers": [
                        {
                            "name": "vs LY",
                            "format": "percent"
                        },
                        {
                            "name": "vs Plan",
                            "format": "absolute"
                        }
                    ]
                }
            },
            "assertion": [
                {
                    "status": 200
                }
            ],
            "extractFirst": {
                "getkpi_scenario_id": "rowData.scenarioId",
                "getkpi_scenario_version": "rowData.scenarioVersion"
            }
        },
        {
            "testStep": "Get kpi value for vsLY",
            "environment": "qa",
            "labels": [
                "IBGROW-38563"
            ],
            "service": "coreService",
            "uri": "getKpiV2",
            "testName": "Get kpi value for vsLY for forecast comparison",
            "queryParams": "",
            "method": "POST",
            "payload": {
                "scenario_id": "{{getkpi_scenario_id}}",
                "scenario_version": "{{getkpi_scenario_version}}",
                "dim_id": 11,
