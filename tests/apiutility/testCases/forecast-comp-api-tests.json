            "assertion": [
                {
                    "status": 200
                },
                {
                    "assertResponseByCalculation": {
                        "value1": "{{forecastValue}}",
                        "value2": "{{vsLyAbsoluteValue}}",
                        "sign": "-",
                        "expected": "{{vsLyDifferenceValue}}",
                        "acceptedDifference": 0.1000
                    }
                },
                {
                    "assertResponseByCalculation": {
                        "value1": "{{forecastValue}}",
                        "value2": "{{vsLyAbsoluteValue}}",
                        "sign": "%",
                        "expected": "{{vsLyPercentValue}}",
                        "acceptedDifference": 0.1000
                    }
                }
            ]
