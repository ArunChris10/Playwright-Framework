                    "month": [
                        "{{dynamicMonth-4}}",
                        "{{dynamicMonth-3}}",
                        "{{dynamicMonth-2}}",
                        "{{dynamicMonth-1}}",
                        "{{dynamicMonth}}",
                        "{{dynamicMonth+1}}",
                        "{{dynamicMonth+2}}",
