          "momarkdownsnet",
          "moreceiptsatretail",
          "moreceiptsatcostwithoutcash",
          "mocoops",
          "modeals",
          "momonthendaccrual",
          "moothernonstorereceipts",
          "mocashcoop",
          "moreceiptsatcostwithcash",
          "moimupctwithoutcash",
          "moimupctwithcash",
          "moendinginventoryatcostinput",
