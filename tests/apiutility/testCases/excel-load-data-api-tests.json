{
  "validate_excel_load_data listHistoricals": [
    {
      "testStep": "Extract scenario version from listHistoricals API",
      "environment": "qa",
      "labels": ["smoke", "regression", "listHistoricals"],
      "service": "coreService",
      "uri": "listHistoricals",
      "testName": "Get scenarios for excel",
      "queryParams": "dim_val_id=120010&dim_id=12&data_level=11&classification_id=12",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractFirst": {
        "listHistoricals_scenario_version_timestamp": "row_data.scenario_version_timestamp",
        "listHistoricals_scenario_id": "row_data.scenario_id",
        "listHistoricals_actual_template_id": "row_data.actual_template_id",
        "listHistoricals_forecast_template_id": "row_data.forecast_template_id"
      }
    },
    {
      "testStep": "Validate scenarios API - complete node list",
      "environment": "qa",
      "labels": ["smoke", "excel"],
      "service": "reportingService",
      "uri": "scenarios",
