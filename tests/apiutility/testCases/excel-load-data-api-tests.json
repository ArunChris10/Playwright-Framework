          "moendinginventoryatcostcalculated",
          "molevelofcalc",
          "moendinginventoryatcost",
          "mobegininventoryatcost",
          "mocostofgoodssold",
          "moshrink",
          "mopostaudit",
          "mobuyingallowances",
          "mowarehouseallowances",
          "moimportallowances",
          "moothercostofsales",
          "mototalallowances",
          "modcthrows",
          "mocostofsales",
          "mogrossprofit"
        ],
        "scenarios": [
          {
            "scenario_id": "{{listHistoricals_scenario_id}}",
            "scenario_ver": "{{listHistoricals_scenario_version_timestamp}}",
            "actual_scenario_id": "{{listHistoricals_actual_template_id}}",
            "forecast_scenario_id": "{{listHistoricals_forecast_template_id}}",
            "type": "scenarios"
          }
        ],
        "filters": {},
        "hierarchy_names": ["MP_CHANNEL_LEVELS", "SBU"],
        "periods": [
          "{{dynamicMonth-5}}",
          "{{dynamicMonth-4}}",
          "{{dynamicMonth-3}}",
          "{{dynamicMonth-2}}",
          "{{dynamicMonth-1}}",
          "{{dynamicMonth}}",
          "{{dynamicMonth+1}}",
          "{{dynamicMonth+2}}",
          "{{dynamicMonth+3}}",
          "{{dynamicMonth+4}}",
          "{{dynamicMonth+5}}",
          "{{dynamicMonth+6}}"
        ],
        "period_type": "month",
        "period_levels": [],
        "dimensions": ["channel_l3", "channel_l2", "channel_l1"],
        "pivot_rows": ["node_var_name", "channel_l3", "channel_l1", "channel_l2"],
        "pivot_columns": ["period", "scenario_id"]
      },
      "assertions": [
        {
          "status": 200
        }
      ]
    },
