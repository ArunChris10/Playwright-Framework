{
  "validate_drivers_contains_data": [
    {
      "testStep": "Get forecast for scenario id and scenario version",
      "environment": "qa",
      "labels": ["smoke","validator"],
      "service": "coreService",
      "uri": "getForecast",
      "testName": "Validate create forecast",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "classification_id": 12,
        "dim_id": 12,
        "dim_val_id": 120010,
        "template_id": 1
      },
      "extractRelative": 
      {
        "node_validator_asString_scenario_version_timestamp": {
          "whereKey": "rowData.name",
          "equals": "Forecast 1",
          "extractKey": "rowData.scenarioVersion"
        },
        "node_validator_asString_scenario_id": {
          "whereKey": "rowData.name",
          "equals": "Forecast 1",
          "extractKey": "rowData.scenarioId"
        },
        "node_validator_scenario_version_timestamp": {
          "whereKey": "rowData.name",
          "equals": "Forecast 1",
          "extractKey": "rowData.scenarioVersion"
        },
        "node_validator_scenario_id": {
          "whereKey": "rowData.name",
          "equals": "Forecast 1",
          "extractKey": "rowData.scenarioId"
        }
      },
      "assertions": [
        {
          "status": 200
        }
      ]
    },
