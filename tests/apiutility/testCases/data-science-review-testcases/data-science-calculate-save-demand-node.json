{
  "validate_datascience_calculate_and_save_demand_node_flow": [
    {
      "testStep": "Fetch Scenario Info for DataScience",
      "environment": "qa",
      "labels": ["smoke", "Pre-Req", "IBGROW-35039", "IBGROW-34989", "MS2"],
      "service": "coreService",
      "uri": "getDataScienceInfo",
      "testName": "Get scenario details from DataScience info",
      "queryParams": "",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "datascience_scenario_id": {
          "whereKey": "classification_id",
          "equals": 12,
          "extractKey": "scenario_id"
        },
        "datascience_scenario_version": {
          "whereKey": "classification_id",
          "equals": 12,
          "extractKey": "scenario_version"
        }
      }
    },
    {
      "testStep": "Allocate Forecast for DataScience Node",
      "environment": "qa",
      "labels": ["smoke", "IBGROW-35039", "IBGROW-34989", "MS2"],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Send forecast allocation request - DataScience Demand",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [],
        "scenario_id": "{{datascience_scenario_id}}",
        "dim_val_id": 130001,
        "dim_id": 13,
        "preview": true,
        "edits": [
          {
            "node_var_name": "grossgmv",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 10000
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 13061746521633
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertApproxEquals": {
            "jsonPath": "edits.{{dynamicMonth+1}}.forecast",
            "expected": 10000.000000000005,
            "acceptedDifference": 0.1000
          }
        }
      ]
    },
    {
      "testStep": "Save Adjustment for DataScience Allocation",
      "environment": "qa",
      "labels": ["smoke", "IBGROW-35039", "IBGROW-34989", "MS2"],
      "service": "coreService",
      "uri": "saveAdjustment",
      "testName": "Save adjustment for DataScience Demand forecast",
      "queryParams": "",
      "method": "PATCH",
      "payload": {
        "adjustment_metadata": {
          "adjustment_name": "test Automation adjustment",
          "adjustment_reason": "test",
          "adjustment_type": 74,
          "is_duplicated": false,
          "is_update": false,
          "is_create": true,
          "adjustment_edits": 1,
          "scenario_id": "{{datascience_scenario_id}}",
          "scenario_version_timestamp": "{{datascience_scenario_version}}"
        },
        "allocation_request": {
          "display_nodes": [],
          "scenario_id": "{{datascience_scenario_id}}",
          "dim_val_id": 130001,
          "dim_id": 13,
          "preview": false,
          "edits": [
            {
              "node_var_name": "grossgmv",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 10000
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            }
          ],
          "filters": [],
          "period_view": "month"
        },
        "dim_val_id": 130001
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "New adjustment created successfully!!",
            "jsonPath2": "adjustment_metadata.adjustment_name",
            "value2": "test Automation adjustment",
            "jsonPath3": "adjustment_metadata.adjustment_reason",
            "value3": "test"
          },
          "assertNotNull": {
            "jsonPath1": "adjustment_metadata.adjustment_id",
            "jsonPath2": "adjustment_metadata.created_by",
            "jsonPath3": "adjustment_metadata.created_at"
          }
        }
      ],
      "extract": {
        "adjustment_id": "adjustment_metadata.adjustment_id"
      }
    },
    {
      "testStep": "Validate Forecasted Data in KPI View",
      "environment": "qa",
      "labels": ["smoke", "IBGROW-35039", "IBGROW-34989", "MS2"],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "Validate forecasted 'grossgmv' data in KPI output",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "scenario_id": "{{datascience_scenario_id}}",
        "scenario_version": "{{datascience_scenario_version}}",
        "dim_id": 13,
        "dim_val_id": 130001,
        "classification_id": 12,
        "template_id": 3,
        "filters": [],
        "additional_filters": {
          "pivot_cols": ["month"],
          "pivot_index": ["node_id"],
          "period_view": ["month"],
          "nodes": ["grossgmv"],
          "template_include_headers": [
            {
              "name": "Driver"
            }
          ],
          "month": ["{{dynamicMonth+1}}"]
        },
        "isApplied": false
      },
      "assertions": [
        {
          "status": 200
        },
       
        {
          "assertApproxEquals": {
            "jsonPath": "rowData.{{dynamicMonth+1}}.forecast",
            "expected": 9999.999999999998,
            "acceptedDifference": 0.1000
          }
        }
      ]
    }
  ]
}
