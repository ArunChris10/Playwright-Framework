{
  "validate_datascience3_adjustment_nondemand": [
    {
            "runInParallel": false,
      "testStep": "Get Scenario details from dataScience info",
      "environment": "qa",
      "labels": [
        "smoke",
        "Pre-Req",
        "IBGROW-35040",
        "IBGROW-34988",
        "MS1",
        "Visualization",
        "DataScience",
        "Admin-Isolated-Scenarios"
      ],
      "service": "coreService",
      "uri": "getDataScienceInfo",
      "testName": "get Scenario details from dataScience info",
      "queryParams": "",
      "method": "GET",
      "assertions": [
        {
          "status": 200
        }
      ],
      "extractRelative": {
        "datascience3_scenario_id": {
          "whereKey": "classification_id",
          "equals": 12,
          "extractKey": "scenario_id"
        },
        "datascience3_scenario_version": {
          "whereKey": "classification_id",
          "equals": 12,
          "extractKey": "scenario_version"
        }
      }
    },
    {
      "testStep": "Send request for allocate-data - DataScience- NonDemand",
      "environment": "qa",
      "labels": [
        "smoke",
        "IBGROW-35040",
        "IBGROW-34988",
        "MS1"
      ],
      "service": "coreService",
      "uri": "allocateData",
      "testName": "Send request for allocate-data - DataScience- NonDemand",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "display_nodes": [],
        "scenario_id": "{{datascience3_scenario_id}}",
        "dim_val_id": 130001,
        "dim_id": 13,
        "preview": true,
        "edits": [
          {
            "node_var_name": "moecommreturnscogs",
            "node_dimension": {},
            "data": {
              "{{dynamicMonth+1}}": 25000000.12
            },
            "allocation": {
              "interval": null,
              "offset": null,
              "method": 29
            }
          }
        ],
        "filters": [],
        "period_view": "month",
        "adjustment_id": 1746012292426
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertApproxEquals": {
            "jsonPath": "edits.{{dynamicMonth+1}}.forecast",
            "expected": 25000000.12,
            "acceptedDifference": 0.1000
          }
        }
      ]
    },
    {
      "testStep": "Send request for save-adjustment - DataScience - NonDemand",
      "environment": "qa",
      "labels": [
        "smoke",
        "IBGROW-35040",
        "IBGROW-34988",
        "MS1"
      ],
      "service": "coreService",
      "uri": "saveAdjustment",
      "testName": "Send request for save-adjustment- DataScience- NonDemand",
      "queryParams": "",
      "method": "PATCH",
      "payload": {
        "adjustment_metadata": {
          "adjustment_name": "test Automation adjustment",
          "adjustment_reason": "test",
          "adjustment_type": 73,
          "is_duplicated": false,
          "is_update": false,
          "is_create": true,
          "adjustment_edits": 1,
          "scenario_id": "{{datascience3_scenario_id}}",
          "scenario_version_timestamp": "{{datascience3_scenario_version}}"
        },
        "allocation_request": {
          "display_nodes": [],
          "scenario_id": "{{datascience3_scenario_id}}",
          "dim_val_id": 130001,
          "dim_id": 13,
          "preview": false,
          "edits": [
            {
              "node_var_name": "moecommreturnscogs",
              "node_dimension": {},
              "data": {
                "{{dynamicMonth+1}}": 25000000.12
              },
              "allocation": {
                "interval": null,
                "offset": null,
                "method": 29
              }
            }
          ],
          "filters": [],
          "period_view": "month"
        },
        "dim_val_id": 130001
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "New adjustment created successfully!!",
            "jsonPath2": "adjustment_metadata.adjustment_name",
            "value2": "test Automation adjustment",
            "jsonPath3": "adjustment_metadata.adjustment_reason",
            "value3": "test"
          },
          "assertNotNull": {
            "jsonPath1": "adjustment_metadata.adjustment_id",
            "jsonPath2": "adjustment_metadata.created_by",
            "jsonPath3": "adjustment_metadata.created_at"
          }
        }
      ],
      "extract": {
        "adjustment_id": "adjustment_metadata.adjustment_id"
      }
    },
    {
      "testStep": "Validate saved data for datascience - GetKpi",
      "environment": "qa",
      "labels": [
        "smoke",
        "IBGROW-35040",
        "IBGROW-34988",
        "MS1"
      ],
      "service": "coreService",
      "uri": "getKpi",
      "testName": "Validate saved data for datascience - GetKpi",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "scenario_id": "{{datascience3_scenario_id}}",
        "scenario_version": "{{datascience3_scenario_version}}",
        "dim_id": 13,
        "dim_val_id": 130001,
        "classification_id": 12,
        "template_id": 3,
        "filters": [],
        "additional_filters": {
          "pivot_cols": [
            "month"
          ],
          "pivot_index": [
            "node_id"
          ],
          "period_view": [
            "month"
          ],
          "nodes": [
            "moecommreturnscogs"
          ],
          "template_include_headers": [
            {
              "name": "Driver"
            }
          ],
          "month": [
            "{{dynamicMonth+1}}"
          ]
        },
        "isApplied": false
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertApproxEquals": {
            "jsonPath": "rowData.{{dynamicMonth+1}}.forecast",
            "expected": 25000000.12,
            "acceptedDifference": 0.1000
          }
        }
      ]
    }
  ]
}