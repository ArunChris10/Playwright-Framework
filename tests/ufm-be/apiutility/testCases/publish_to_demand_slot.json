,
  {
    "environment": "qa",
    "labels": [
      "smoke",
      "IBGROW-35119",
     "Pallavi"
    ],
    "testName": "Verify Actuals numbers are published to current demand slot 3 and is matching with AOP admin data",
    "uri": "AopGetKpi",
    "method": "POST",
    "service": "coreService",
    "queryParams": "",
    "payload": {
      "baseChannel": [],
      "baseChannelIds": [],
      "channelGroup": [],
      "channelGroupIds": [],
      "clearAll": false,
      "demandChannel": [],
      "department": [],
      "departmentIds": [],
      "departmentName": [],
      "fetchFromBq": true,
      "filterLoadComplete": true,
      "filtersChanged": true,
      "includeDerivedMetrics": false,
      "includeTotals": true,
      "isUfmSyncCache": true,
      "latestSyncScenario": true,
      "layerIds": [],
      "loadHeirarchyParams": null,
      "organizationalLevel": "SBU",
      "sbu": [
        "FASHION",
        "CONSUMABLES",
        "ENTERTAINMENT TOYS AND SEASONAL",
        "FOOD",
        "HARDLINES",
        "HOME"
      ],
      "sbuIds": [4, 29, 196, 27, 60, 47],
      "timeFilter": {
        "filterLevel": "MONTH",
        "isYearSelected": true,
        "isMonthSelected": true,
        "isQuarterSelected": false
        
      }
    }
    ,
    "assertion": [
      {
        "status": 200
      },
      {
        "extractRelative": {
          "CurrentDemandDriverOneFirstMonthActuals": {
            "whereKey": "forecastTotals.grandTotal.forecast.month",
            "equals": "1",
            "whereKey": "forecastTotals.grandTotal.forecast.year",
            "equals": "2023",
            "extractKey": "rowData.grandTotal.forecast.grossGmv"
          },
          "CurrentDemandDriverOneSecondMonthActuals": {
            "whereKey": "forecastTotals.grandTotal.forecast.month",
            "equals": "2",
            "whereKey": "forecastTotals.grandTotal.forecast.year",
            "equals": "2023",
           "extractKey": "rowData.grandTotal.forecast.grossGmv"
          },
          "CurrentDemandDriverOneThirdMonthActuals": {
            "whereKey": "forecastTotals.grandTotal.forecast.month",
            "equals": "3",
            "whereKey": "forecastTotals.grandTotal.forecast.year",
            "equals": "2023",
            "extractKey": "rowData.grandTotal.forecast.grossGmv"
          },
          "CurrentDemandDriverOneForthMonthActuals": {
            "whereKey": "forecastTotals.grandTotal.forecast.month",
            "equals": "4",
            "whereKey": "forecastTotals.grandTotal.forecast.year",
            "equals": "2023",
          "extractKey": "rowData.grandTotal.forecast.grossGmv"
          }
        },
        "validateExtract": {
          "CurrentDemandDriverOneFirstMonthActuals": "DriverOneFirstMonthActuals",
          "CurrentDemandDriverOneSecondMonthActuals": "DriverOneSecondMonthActuals", 
          "CurrentDemandDriverOneThirdMonthActuals": "DriverOneThirdMonthActuals",
          "CurrentDemandDriverOneForthMonthActuals": "DriverOneForthMonthActuals"
        }
      }
    ]
  }
]