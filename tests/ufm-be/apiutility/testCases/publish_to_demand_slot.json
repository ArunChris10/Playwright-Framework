          { "name": "{{dynamicMonth-39}}", "columnsMenuParams": "middleColumns" },
          { "name": "{{dynamicMonth-38}}", "columnsMenuParams": "middleColumns" },
          { "name": "{{dynamicMonth-37}}", "columnsMenuParams": "middleColumns" }
