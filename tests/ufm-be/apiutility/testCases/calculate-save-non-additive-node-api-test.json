[   
 {
  "environment": "qa",
  "labels": [
    "smoke",
    "Pre-Req",
    "Nidhi"
  ],
  "service": "coreService",
  "uri": "getForecast",
  "testName": "get Forecast to fetch Scenario ID",
  "queryParams": "",
  "method": "POST",
  "payload": {
    "unit": "Millions",
    "dim_id": 12,
    "dim_val_id": 120009,
    "classification_id": 12,
    "template_id": 1,
    "filters": [],
    "additional_filters": {
      "template_include_headers": [
        {
          "name": "vs LY",
          "format": "percent"
        },
        {
          "name": "vs Plan",
          "format": "absolute"
        }
      ]
    }
  },
  "assertion": [
    {
      "status": 200
    }
  ],
  "extractRelative": {
    "scenario_id": {
      "whereKey": "rowData.name",
      "equals": "io",
      "extractKey": "scenarioId"
    }
  }
},
{
  "environment": "qa",
  "labels":  ["smoke","IBGROW-38428","Pallavi"],
  "service":"coreService",
  "uri":"allocateData",
  "testName": "Verify calculate is working when any filter combination is applied on non-additive node maintain ratio",
  "queryParams": "",
  "method": "POST",
  "payload": {
    "adjustment_id":1747138163432,
    "dim_id":11,
    "dim_val_id":110027,
   
    "display_nodes":[],
    "edits":[
      {
        "node_var_name": "allocationpctmerchandiseincome_input",
        "node_dimension": {
          "department": 1
        },
        "data": {
          "{{dynamicMonth+1}}": 0.89
        },
        "allocation": {
          "interval": null,
          "offset": null,
          "method": 29
        }
      }
    ],
    "filters":[
      {
        "dim_id": 1,
        "dim_val_ids": [
          1
        ],
        "children": []
      }
    ],
   "period_view": "month",
"preview": true,
"scenario_id": "{{scenario_id}}"
  },
  "assertion": [
    {
       "status": 200 
    },
    {
      "assertEquals": {
        "jsonPath1": "node_var_name",
        "value1": "merchandiseincomeallocatedtoentity"
      }
    }
  ,
  {
    "extractRelative": {
      "forecastDriverOne": {
        "whereKey": "node_var_name",
        "equals": "merchandiseincomeallocatedtoentity",
        "extractKey": "edits.{{dynamicMonth+1}}.forecast"
      },
      "forecastDriverTwo": {
        "whereKey": "node_var_name",
        "equals": "allocationpctmerchandiseincome_input",
        "extractKey": "edits.{{dynamicMonth+1}}.forecast"
      } },
    "validateExtract": {
      "forecastDriverOne": -62351.1661,
      "forecastDriverTwo": 0.89
    }
  }
]
},
