  },
  "assertions": {
    "status": 200 
  },
  "extract": {
    "UFM_SCENARIO_TYPE_ID": "UFM_SCENARIO_TYPE_ID",
    "UFM_SCENARIO_STS_ID":"UFM_SCENARIO_STS_ID",
    "SAVED_FILTR_TYPE_ID":"SAVED_FILTR_TYPE_ID"
  },

  "tags": ["smoke", "login"]
}
]
  