      "IBGROW-36154",
      "Pallavi"
    ],
    "service": "coreService",
    "uri": "getForecastCalendar",
    "testName": "Verify create forecast cycle api",
    "queryParams": "{{this_calendar_id}}/cycles",
    "method": "POST",
    "payload": {
      "deadlines": [
        {
          "dim_id": 13,
          "dim_val_id": "130001",
          "event_id": 28,
          "deadline": "2025-09-12 00:00",
          "timezone": "CST"
        }
      ]
    },
    "assertion": [
      {
        "status": 201
      },
      {
        "assertNotNull": {
          "jsonPath": "cycle_id"
        }
      }
    ],
    "extractFirst": {
      "new_cycle_id": "cycle_id"
    }
  },
