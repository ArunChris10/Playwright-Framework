    ],
    "service": "coreService",
    "uri": "getForecastCalendar",
    "testName": "get forecast Calendar API",
    "queryParams": "?dim_id=13&dim_val_id=130001&classification_id=12&fiscal_year=2026",
    "method": "GET",
    "assertion": [
      {
        "status": 200
      },
      {
        "assertEquals": {
          "jsonPath1": "submission_cycles.submission_cycle_details.dim_id",
          "value1": 13,
          "jsonPath2": "submission_cycles.submission_cycle_details.dim_val_id",
          "value2": 130001
        },
        "assertNotNull": {
          "jsonPath1": "calendar_id",
          "jsonPath2": "submission_cycles.cycle_id",
          "jsonPath3": "submission_cycles.submission_cycle_details.event_id",
          "jsonPath4": "submission_cycles.submission_cycle_details.deadline_date"
        }
      }
    ],
    "extractFirst": {
      "this_calendar_id": "calendar_id",
      "this_cycle_id": "submission_cycles.cycle_id"
    }
  },
  {
    "environment": "qa",
    "labels": [
      "smoke",
