      "aggregationLevel": "MONTH",
      "dimensions": ["channel_l3", "channel_l2", "channel_l1"],
      "pivot_rows": ["Node Name", "Channel L0", "Channel L1", "Channel L2"],
      "pivot_columns": ["Date", "Scenario Name"]
