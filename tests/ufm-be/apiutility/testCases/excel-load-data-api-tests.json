      "scenarios": [
        {
          "scenarioId": "{{scenario_id}}",
          "scenarioVer": "{{scenario_version_timestamp}}"
        }
      ],
      "filters": {},
      "hierarchy_names": ["MP_CHANNEL_LEVELS", "SBU"],
      "periods": [
        "{{dynamicMonth-5}}",
        "{{dynamicMonth-4}}",
        "{{dynamicMonth-3}}",
        "{{dynamicMonth-2}}",
        "{{dynamicMonth-1}}",
        "{{dynamicMonth}}",
        "{{dynamicMonth+1}}",
        "{{dynamicMonth+2}}",
        "{{dynamicMonth+3}}",
        "{{dynamicMonth+4}}",
        "{{dynamicMonth+5}}",
        "{{dynamicMonth+6}}"
