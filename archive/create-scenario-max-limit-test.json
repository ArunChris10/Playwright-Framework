      "testStep": "Create Forecast Scenario 1",
      "environment": "qa",
      "labels": ["smoke", "regression", "IBGROW-38439", "create-scenario"
      ],
      "service": "coreService",
      "uri": "createForecast",
      "testName": "Validate create forecast",
      "queryParams": "",
      "method": "POST",
      "payload": {
        "type": 3,
        "name": "test-1{{randomNumber}}",
        "classification_id": 12,
        "dim_id": 11,
        "dim_val_id": 110027
      },
      "assertions": [
        {
          "status": 200
        },
        {
          "assertEquals": {
            "jsonPath1": "message",
            "value1": "Scenario created successfully"
          }
        }
      ],
      "extractRelativeMultipleCondition": {
        "scenario_id_1": {
          "conditions": [],
          "extractKey": "scenario.scenario_id"
        },
        "scenario_version_1": {
